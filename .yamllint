---
# Repository-wide yamllint configuration (used by `make lint` and ansible-lint).
extends: default

ignore: |
  ansible/collections/
  node_modules/
  .wrangler/
  release/out/
  # unmodified upstream copy of supabase docker/ (self-hosted/v0.8.4)
  bundle/compose/supabase/

rules:
  line-length:
    max: 120
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
  # Settings required by ansible-lint's yaml rule.
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
