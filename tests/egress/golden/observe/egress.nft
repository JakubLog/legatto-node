# Generated by legatto-egress (legatto-egress 1.0.0). Do not edit: the next apply overwrites it.
# Release: 1.4.0. Mode: observe.
#
# Included by /etc/nftables.conf after `table inet legatto` (net lane), which
# jumps to egress_out from its output hook and to egress_fwd for every packet
# from a Docker bridge to the WAN. legatto-egress apply loads this file in one
# transaction after flushing both chains, so a reload replaces the rules.
# observe: unknown traffic is logged and counted, then accepted.
# enforce: unknown traffic is logged and counted, then dropped.
table inet legatto {
	counter egress_denied_host {
		comment "host: new connection outside the per-user rules"
	}
	counter egress_denied_fwd {
		comment "containers: new connection to the WAN other than a proxy uplink"
	}
	counter egress_denied_proxy_port {
		comment "host proxy port reached by a user outside legatto_egress_host_proxy_clients"
	}

	chain egress_out {
		# Host proxy 127.0.0.1:4750: only the listed local users.
		ip daddr 127.0.0.1 tcp dport 4750 meta skuid { 0, 42, 991, 992, 993 } accept
		ip daddr 127.0.0.1 tcp dport 4750 ct state new limit rate 6/minute burst 20 packets log prefix "legatto-egress-observe-proxyport " level warn
		ip daddr 127.0.0.1 tcp dport 4750 ct state new counter name "egress_denied_proxy_port" accept
		oifname "lo" accept
		ct state established,related accept
		# Host to containers and to the tailnet.
		oifname { "tailscale0", "br-legatto", "br-lgt-int", "br-lgt-egx", "br-lgt-eapp", "br-lgt-eauth", "br-lgt-efn", "br-lgt-eintk", "br-lgt-epub" } accept
		# Host proxy uplink: ports of the host role entries.
		meta skuid 990 tcp dport { 80, 443 } accept
		# systemd-resolved: DNS over TLS to the configured resolvers only.
		meta skuid 995 ip daddr { 9.9.9.9, 149.112.112.112 } tcp dport { 53, 853 } accept
		meta skuid 995 ip daddr { 9.9.9.9, 149.112.112.112 } udp dport 53 accept
		# chrony: NTP and NTS key establishment.
		meta skuid 994 udp dport 123 accept
		meta skuid 994 tcp dport 4460 accept
		# tailscaled: direct WireGuard paths to tailnet peers.
		meta skuid 0 udp sport 41641 accept
		# DHCPv4/DHCPv6 lease renewal and IPv6 neighbour discovery.
		udp sport 68 udp dport 67 accept
		udp sport 546 udp dport 547 accept
		icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } accept
		limit rate 6/minute burst 20 packets log prefix "legatto-egress-observe-host " level warn
		counter name "egress_denied_host" accept
	}

	chain egress_fwd {
		# Cloud metadata is never reachable from a container, in either mode.
		ip daddr 169.254.169.254 counter name "egress_denied_fwd" drop
		# egress-app (app).
		iifname "br-lgt-egx" ip saddr 172.30.255.2 tcp dport { 443 } accept
		# egress-auth (auth).
		iifname "br-lgt-egx" ip saddr 172.30.255.3 tcp dport { 443 } accept
		# egress-fn (functions): empty allowlist, no uplink.
		# egress-intake (intake).
		iifname "br-lgt-egx" ip saddr 172.30.255.5 tcp dport { 443 } accept
		# egress-publish (publish).
		iifname "br-lgt-egx" ip saddr 172.30.255.6 tcp dport { 443 } accept
		# Name resolution of the active proxies.
		iifname "br-lgt-egx" ip saddr { 172.30.255.2, 172.30.255.3, 172.30.255.5, 172.30.255.6 } ip daddr 9.9.9.9 udp dport 53 accept
		iifname "br-lgt-egx" ip saddr { 172.30.255.2, 172.30.255.3, 172.30.255.5, 172.30.255.6 } ip daddr 9.9.9.9 tcp dport 53 accept
		limit rate 6/minute burst 20 packets log prefix "legatto-egress-observe-fwd " level warn
		counter name "egress_denied_fwd" accept
	}
}
