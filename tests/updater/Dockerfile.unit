# Test image for the updater lane: Ubuntu 24.04 (the server OS) with the
# Python and OpenSSH the server uses. Used by tests/updater/run.sh only.
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 openssh-client tzdata \
 && rm -rf /var/lib/apt/lists/*
