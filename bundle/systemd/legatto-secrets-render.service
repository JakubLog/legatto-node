# Render /run/legatto/env/*.env and /run/legatto/keys/pii_field_key (tmpfs) from the
# release env templates, /etc/legatto/office.env, the office feature flags and
# /etc/legatto/secrets. Runs at boot before legatto-stack and whenever the feature
# flags change (legatto-secrets-render.path); `refresh` then recreates the
# containers whose environment changed (skipped at boot and during an update).
[Unit]
Description=Render Legatto env files and keys into /run/legatto
Before=legatto-stack.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/opt/legatto/sbin/legatto-secrets render
ExecStartPost=/opt/legatto/sbin/legatto-stack refresh
TimeoutStartSec=15min
