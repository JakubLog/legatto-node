# Feature flags are changed only by the office admin (console request features.set,
# atomic rename of /var/lib/legatto/office/features.json); re-render env files then.
[Unit]
Description=Re-render Legatto env files when the office feature flags change

[Path]
PathChanged=/var/lib/legatto/office/features.json

[Install]
WantedBy=multi-user.target
