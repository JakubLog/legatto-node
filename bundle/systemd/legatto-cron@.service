# One scheduled job of the app (vercel.json "crons"), started by legatto-cron-<name>.timer.
# GET http://172.30.0.10:3000/api/cron/<name> with the cron secret, which reaches the
# tool as a systemd credential (never in argv or the environment).
[Unit]
Description=Legatto app cron job %i
After=legatto-stack.service
Requisite=legatto-stack.service

[Service]
Type=oneshot
DynamicUser=yes
LoadCredential=cron_secret:/etc/legatto/secrets/cron_secret
ExecStart=/opt/legatto/sbin/legatto-stack cron %i
TimeoutStartSec=150

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=172.30.0.10/32
