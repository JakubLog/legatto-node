# GoTrue (service auth) settings not present in the upstream compose file.
# Values mirror legatto-app scripts/instances/policy.mjs (authConfig + PRO_AUTH_CONFIG);
# names: supabase/auth internal/conf/configuration.go (envconfig prefix GOTRUE).

# --- passwords ----------------------------------------------------------------------------
GOTRUE_PASSWORD_MIN_LENGTH=12
GOTRUE_PASSWORD_REQUIRED_CHARACTERS=abcdefghijklmnopqrstuvwxyz:ABCDEFGHIJKLMNOPQRSTUVWXYZ:0123456789:!@#$%^&*()_+-=[]{};'\\:"|<>?,./`~
# HIBP k-anonymity check (D13), fail-open; egress through egress-auth when the office keeps it on.
GOTRUE_PASSWORD_HIBP_ENABLED=${feature_bool:hibp}
GOTRUE_PASSWORD_HIBP_FAIL_CLOSED=false

# --- MFA, sessions, refresh tokens ------------------------------------------------------------
GOTRUE_MFA_TOTP_ENROLL_ENABLED=true
GOTRUE_MFA_TOTP_VERIFY_ENABLED=true
GOTRUE_SESSIONS_TIMEBOX=720h
GOTRUE_SESSIONS_INACTIVITY_TIMEOUT=168h
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL=10
GOTRUE_SECURITY_UPDATE_PASSWORD_REQUIRE_REAUTHENTICATION=true
GOTRUE_SECURITY_UPDATE_PASSWORD_REQUIRE_CURRENT_PASSWORD=true
GOTRUE_MAILER_SECURE_EMAIL_CHANGE_ENABLED=true
GOTRUE_MAILER_SUBJECTS_INVITE=Zaproszenie do systemu biura poselskiego

# --- Auth mail: Send Email Hook -> app internal listener (K10 A, no SMTP on the server) ---------
# GoTrue allows http:// hooks only for localhost/host.docker.internal; compose maps
# host.docker.internal to the app's fixed legatto-int address (contract legatto_ip_int_net.app).
GOTRUE_HOOK_SEND_EMAIL_ENABLED=true
GOTRUE_HOOK_SEND_EMAIL_URI=http://host.docker.internal:3001/_internal/auth-hooks/send-email
GOTRUE_HOOK_SEND_EMAIL_SECRETS=${secret:auth_hook_secret}

# --- egress (contract legatto_egress_container_proxies.auth) -----------------------------------
HTTPS_PROXY=http://egress-auth:4750
HTTP_PROXY=http://egress-auth:4750
NO_PROXY=api-gw,kong,envoy,db,rest,auth,storage,realtime,meta,functions,app,localhost,127.0.0.1,host.docker.internal
