# Interpolation values for docker compose (--env-file /run/legatto/env/compose.env).
# Feeds the ${...} references of the unchanged upstream compose file and of
# docker-compose.legatto.yml. Rendered by `legatto-secrets render`; syntax in its --help.
# Every variable the upstream file references is defined here (no "variable is not set").

# --- office (contract legatto_office_env) ------------------------------------------------
LEGATTO_HOST_CRM=${LEGATTO_HOST_CRM}
LEGATTO_TS_IP4=${LEGATTO_TS_IP4}

# --- database ------------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=${secret:postgres_password}

# --- API keys (legacy HS256, D12) ---------------------------------------------------------------
JWT_SECRET=${secret:jwt_secret}
JWT_EXPIRY=3600
JWT_JWKS=
ANON_KEY=${secret:anon_key}
SERVICE_ROLE_KEY=${secret:service_role_key}
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- URLs: one origin, app.<domain> (U5) ------------------------------------------------------
SUPABASE_PUBLIC_URL=https://${LEGATTO_HOST_CRM}
API_EXTERNAL_URL=https://${LEGATTO_HOST_CRM}/auth/v1
SITE_URL=https://${LEGATTO_HOST_CRM}
ADDITIONAL_REDIRECT_URLS=https://${LEGATTO_HOST_CRM}/login,https://${LEGATTO_HOST_ADMIN}/login

# --- Auth (GoTrue) values referenced by the upstream file; the rest is in auth.env.tmpl ---------
# Accounts are created by the MP (admin-create-user); e-mail/password login stays enabled.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
# No SMTP on the server: Auth mail goes through the send-email hook (auth.env.tmpl).
# GOTRUE_SMTP_PORT is parsed as an integer even when unused.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

# --- PostgREST (legatto-app supabase/config.toml [api]) -----------------------------------------
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# --- Realtime, Studio, meta --------------------------------------------------------------------
SECRET_KEY_BASE=${secret:secret_key_base}
REALTIME_DB_ENC_KEY=${secret:realtime_db_enc_key}
PG_META_CRYPTO_KEY=${secret:pg_meta_crypto_key}
DASHBOARD_USERNAME=legatto
DASHBOARD_PASSWORD=${secret:dashboard_password}
STUDIO_DEFAULT_ORGANIZATION=${LEGATTO_OFFICE_TITLE}
STUDIO_DEFAULT_PROJECT=Legatto
OPENAI_API_KEY=

# --- Storage (file backend in the storage-data volume; S3 endpoint blocked in Caddy) -----------
GLOBAL_S3_BUCKET=stub
REGION=local
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=${secret:s3_protocol_access_key_id}
S3_PROTOCOL_ACCESS_KEY_SECRET=${secret:s3_protocol_access_key_secret}

# --- Edge Functions --------------------------------------------------------------------------
FUNCTIONS_VERIFY_JWT=true
FUNCTIONS_MEMORY_LIMIT=768m

# --- Disabled upstream services (profile "disabled"; values only satisfy interpolation) --------
IMGPROXY_AUTO_WEBP=false
VAULT_ENC_KEY=
POOLER_TENANT_ID=legatto
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6543
# api-gw ports are reset in the override; defined only for interpolation.
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000
