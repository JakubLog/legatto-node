# Edge Functions (service functions) settings added to the upstream environment
# (JWT_SECRET, SUPABASE_URL, SUPABASE_PUBLIC_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY, VERIFY_JWT come from compose.env through the upstream file).

ALLOWED_ORIGINS=https://${LEGATTO_HOST_CRM},https://${LEGATTO_HOST_ADMIN}
AUTH_REDIRECT_URL=https://${LEGATTO_HOST_CRM}/login
INSTANCE_GETRESPONSE=${feature:getresponse}
# admin-* functions accept only requests that Caddy tagged X-Legatto-Surface: admin (A5).
LEGATTO_SURFACE_ENFORCE=1

# --- egress (contract legatto_egress_container_proxies.functions) -----------------------------
HTTPS_PROXY=http://egress-fn:4750
HTTP_PROXY=http://egress-fn:4750
NO_PROXY=api-gw,kong,envoy,db,rest,auth,storage,realtime,functions,app,localhost,127.0.0.1
