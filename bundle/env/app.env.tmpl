# legatto-app Node server (service app). Interface agreed with the app lane (A1-A4, A9-A11).

LEGATTO_TARGET=selfhost
PORT=3000
INTERNAL_PORT=3001
APP_TITLE=${LEGATTO_OFFICE_TITLE}
OAUTH_ISSUER=https://${LEGATTO_HOST_CRM}
ADMIN_ORIGIN=https://${LEGATTO_HOST_ADMIN}
AUTH_REDIRECT_URL=https://${LEGATTO_HOST_CRM}/login
# Only Caddy (host side of legatto-host) may set X-Forwarded-* and X-Legatto-Surface.
TRUSTED_PROXY_IPS=172.30.0.1

# --- Supabase (internal gateway, no TLS hop) -------------------------------------------------------
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=${secret:anon_key}
SUPABASE_SERVICE_ROLE_KEY=${secret:service_role_key}
CRON_SECRET=${secret:cron_secret}
GOTRUE_HOOK_SEND_EMAIL_SECRETS=${secret:auth_hook_secret}

# --- feature flags (office console, /var/lib/legatto/office/features.json) ------------------------
INSTANCE_AI=${feature:ai}
INSTANCE_MCP=${feature:mcp}
INSTANCE_EMAIL=${feature:email}
INSTANCE_PUSH=${feature:push}
INSTANCE_GETRESPONSE=${feature:getresponse}
INSTANCE_ICS=${feature:ics}
ICS_ALLOWED_HOSTS=${features:ics_hosts}

# --- PII field key: compose secret pii_field_key (from /run/legatto/keys, D11 variant A) ----------
LEGATTO_PII_KEY_FILE=/run/secrets/pii_field_key

# --- egress (contract legatto_egress_container_proxies.app) ---------------------------------------
HTTPS_PROXY=http://egress-app:4750
HTTP_PROXY=http://egress-app:4750
NO_PROXY=api-gw,kong,envoy,db,rest,auth,storage,realtime,meta,functions,app,localhost,127.0.0.1
NODE_USE_ENV_PROXY=1
