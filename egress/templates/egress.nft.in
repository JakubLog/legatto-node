# Generated by legatto-egress (@@GENERATOR@@). Do not edit: the next apply overwrites it.
# Release: @@RELEASE@@. Mode: @@MODE@@.
#
# Included by /etc/nftables.conf after `table inet legatto` (net lane), which
# jumps to egress_out from its output hook and to egress_fwd for every packet
# from a Docker bridge to the WAN. legatto-egress apply loads this file in one
# transaction after flushing both chains, so a reload replaces the rules.
# observe: unknown traffic is logged and counted, then accepted.
# enforce: unknown traffic is logged and counted, then dropped.
table inet legatto {
	counter egress_denied_host {
		comment "host: new connection outside the per-user rules"
	}
	counter egress_denied_fwd {
		comment "containers: new connection to the WAN other than a proxy uplink"
	}
	counter egress_denied_proxy_port {
		comment "host proxy port reached by a user outside legatto_egress_host_proxy_clients"
	}

	chain egress_out {
		# Host proxy @@HOST_PROXY_IP@@:@@HOST_PROXY_PORT@@: only the listed local users.
		ip daddr @@HOST_PROXY_IP@@ tcp dport @@HOST_PROXY_PORT@@ meta skuid { @@HOST_PROXY_CLIENT_UIDS@@ } accept
		ip daddr @@HOST_PROXY_IP@@ tcp dport @@HOST_PROXY_PORT@@ ct state new limit rate 6/minute burst 20 packets log prefix "@@LOG_PREFIX@@-proxyport " level warn
		ip daddr @@HOST_PROXY_IP@@ tcp dport @@HOST_PROXY_PORT@@ ct state new counter name "egress_denied_proxy_port" @@DENY_VERDICT@@
		oifname "lo" accept
		ct state established,related accept
		# Host to containers and to the tailnet.
		oifname { @@LOCAL_IFACES@@ } accept
@@HOST_SERVICE_RULES@@
		limit rate 6/minute burst 20 packets log prefix "@@LOG_PREFIX@@-host " level warn
		counter name "egress_denied_host" @@DENY_VERDICT@@
	}

	chain egress_fwd {
		# Cloud metadata is never reachable from a container, in either mode.
		ip daddr @@METADATA_IP@@ counter name "egress_denied_fwd" drop
@@PROXY_FWD_RULES@@
		limit rate 6/minute burst 20 packets log prefix "@@LOG_PREFIX@@-fwd " level warn
		counter name "egress_denied_fwd" @@DENY_VERDICT@@
	}
}
