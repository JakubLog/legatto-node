---
# Generated by legatto-egress (@@GENERATOR@@). Do not edit: the next apply overwrites it.
# Smokescreen instance for egress role @@ROLE@@.
ip: "@@LISTEN_IP@@"
port: @@LISTEN_PORT@@
acl_file: "@@ACL_FILE@@"
# No client certificates: the default ACL rule applies to every client.
allow_missing_role: true
# IPv4 only: Cloudflare tokens are IP-filtered to the server's public IPv4.
network: ip4
deny_message_extra: "legatto-egress: destination is not on the allowlist of role @@ROLE@@"
@@RESOLVER@@
