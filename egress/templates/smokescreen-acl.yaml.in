---
# Generated by legatto-egress (@@GENERATOR@@). Do not edit: the next apply overwrites it.
# Role: @@ROLE@@. Release: @@RELEASE@@. Mode: @@MODE@@.
#
# Smokescreen v1 ACL. Clients do not present certificates, so every request
# uses the default rule (allow_missing_role in smokescreen.yaml); one proxy
# instance serves one role. Ports are not part of a Smokescreen ACL: nft
# limits the proxy's uplink to the ports of this role's entries.
version: v1
services: []
default:
  name: "legatto-@@ROLE@@"
  project: legatto
  action: @@ACTION@@
  allowed_domains:@@ALLOWED_DOMAINS@@
global_deny_list: []
global_allow_list: []
