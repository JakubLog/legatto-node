class EgressError(Exception):
    """Error with an exit code from CONTRACT §4.6."""

    def __init__(self, message: str, code: int = EXIT_ERROR):
        super().__init__(message)
        self.code = code


def invalid(message: str) -> EgressError:
    return EgressError(message, EXIT_INVALID)


def precondition(message: str) -> EgressError:
    return EgressError(message, EXIT_PRECONDITION)


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def log(message: str) -> None:
    print(f"legatto-egress: {message}", file=sys.stderr)


def canonical(obj: Any) -> bytes:
    return (json.dumps(obj, sort_keys=True, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def read_json(path: Path, what: str) -> Any:
    try:
        with path.open("rb") as fh:
            return json.load(fh)
    except FileNotFoundError:
        raise
    except (OSError, ValueError) as exc:
        raise invalid(f"{what} {path}: cannot read JSON: {exc}") from exc


def write_atomic(path: Path, data: bytes, mode: int = 0o644, gid: int | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        if gid is not None:
            os.chown(tmp, 0, gid)
        os.replace(tmp, path)
        dfd = os.open(str(path.parent), os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def fill(template_name: str, values: dict[str, str]) -> str:
    text = (TEMPLATE_DIR / template_name).read_text(encoding="utf-8")
    for key, value in values.items():
        text = text.replace(f"@@{key}@@", value)
    left = re.findall(r"@@[A-Z0-9_]+@@", text)
    if left:
        raise EgressError(f"template {template_name}: unresolved placeholders {sorted(set(left))}")
    return text


# --------------------------------------------------------------------------- config


class Config:
    """Contract values rendered by the Ansible role into config.json."""

    def __init__(self, path: Path):
        try:
            raw = read_json(path, "config")
        except FileNotFoundError as exc:
            raise precondition(f"missing {path} (installed by the Ansible role egress)") from exc
        if not isinstance(raw, dict) or raw.get("v") != 1:
            raise precondition(f"{path}: unsupported config version")
        self.path = path
        self.raw = raw
        try:
            self.mode: str = raw["mode"]
            self.modes: list[str] = list(raw["modes"])
            self.roles: list[str] = list(raw["roles"])
            self.feature_names: list[str] = list(raw["feature_names"])
            self.feature_defaults: dict[str, bool] = dict(raw["feature_defaults"])
            self.ics_role: str = raw["ics_role"]
            self.office_entries: list[dict] = list(raw["office_entries"])
            self.paths: dict[str, str] = dict(raw["paths"])
            self.status_group: str = raw["status_group"]
            self.host_proxy: dict = dict(raw["host_proxy"])
            self.container_proxies: dict[str, dict] = dict(raw["container_proxies"])
            self.container: dict = dict(raw["container"])
            self.compose_project: str = raw["compose_project"]
            self.nft: dict = dict(raw["nft"])
            self.dns_blackhole: str = raw["dns_blackhole"]
            self.dot_resolvers: list[str] = list(raw["dot_resolvers"])
            self.system_users: dict[str, str] = dict(raw["system_users"])
            self.nodns_units: list[str] = list(raw["nodns_units"])
            self.docker: dict = dict(raw["docker"])
        except (KeyError, TypeError, ValueError) as exc:
            raise precondition(f"{path}: incomplete config: {exc}") from exc
        if self.mode not in self.modes:
            raise precondition(f"{path}: mode {self.mode!r} not in {self.modes}")
        if set(self.container_proxies) | {"host"} != set(self.roles):
            raise precondition(f"{path}: container_proxies + host must equal roles")
        for entry in self.office_entries:
            validate_entry(self, entry, "config office_entries")

    def p(self, key: str) -> Path:
        try:
            return Path(self.paths[key])
        except KeyError as exc:
            raise precondition(f"{self.path}: paths.{key} missing") from exc

    @property
    def container_roles(self) -> list[str]:
        return [r for r in self.roles if r != "host"]


# --------------------------------------------------------------------------- validation


def host_problem(host: Any, allow_wildcard: bool = True) -> str | None:
    if not isinstance(host, str) or not host:
        return "host must be a non-empty string"
    bare = host[2:] if host.startswith("*.") else host
    with contextlib.suppress(ValueError):
        ipaddress.ip_address(bare.strip("[]"))
        return f"{host}: IP literals are not allowed, use a host name"
    if re.fullmatch(r"[0-9.]+", bare) or ":" in host or "/" in host:
        return f"{host}: IP literals, ports and paths are not allowed"
    if len(host) > 253 or not HOST_RE.match(host):
        return f"{host}: not an exact lowercase host name (optionally with one leading '*.')"
    if host.startswith("*."):
        if not allow_wildcard:
            return f"{host}: wildcards are not allowed here"
        if bare.count(".") < 2:
            return f"{host}: wildcard base must have at least three labels"
        if bare in MULTI_TENANT_SUFFIXES:
            return f"{host}: wildcard directly on a multi-tenant suffix"
    return None


def validate_entry(cfg: Config | None, entry: Any, where: str, role: str | None = None) -> dict:
    if not isinstance(entry, dict):
        raise invalid(f"{where}: entry must be an object")
    expected = {"host", "port", "purpose"} | ({"role"} if role is None else set())
    if set(entry) != expected:
        raise invalid(f"{where}: entry keys must be {sorted(expected)}, got {sorted(entry)}")
    r = entry["role"] if role is None else role
    roles = cfg.roles if cfg else list(CONTRACT_ROLES)
    if r not in roles:
        raise invalid(f"{where}: unknown role {r!r}")
    problem = host_problem(entry["host"])
    if problem:
        raise invalid(f"{where}: {problem}")
    port = entry["port"]
    if isinstance(port, bool) or port not in ALLOWED_PORTS:
        raise invalid(f"{where}: {entry['host']}: port must be one of {list(ALLOWED_PORTS)}")
    if port == 80 and r not in PORT80_ROLES:
        raise invalid(f"{where}: {entry['host']}: port 80 is allowed only for role host (APT)")
    purpose = entry["purpose"]
    if not isinstance(purpose, str) or not 1 <= len(purpose) <= 200:
        raise invalid(f"{where}: {entry['host']}: purpose must have 1-200 characters")
    return {"role": r, "host": entry["host"], "port": port, "purpose": purpose}


def validate_role_map(cfg: Config | None, data: Any, where: str) -> dict[str, list[dict]]:
    if not isinstance(data, dict):
        raise invalid(f"{where}: must be an object of role -> entries")
    out: dict[str, list[dict]] = {}
    roles = cfg.roles if cfg else list(CONTRACT_ROLES)
    for role, entries in data.items():
        if role not in roles:
            raise invalid(f"{where}: unknown role {role!r}")
        if not isinstance(entries, list):
            raise invalid(f"{where}.{role}: must be a list")
        if len(entries) > MAX_ENTRIES_PER_ROLE:
            raise invalid(f"{where}.{role}: more than {MAX_ENTRIES_PER_ROLE} entries")
        seen: set[tuple[str, int]] = set()
        checked = []
        for i, e in enumerate(entries):
            v = validate_entry(cfg, e, f"{where}.{role}[{i}]", role=role)
            key = (v["host"], v["port"])
            if key in seen:
                raise invalid(f"{where}.{role}: duplicate {v['host']}:{v['port']}")
            seen.add(key)
            checked.append({"host": v["host"], "port": v["port"], "purpose": v["purpose"]})
        out[role] = checked
    return out


def validate_egress(cfg: Config | None, egress: Any, where: str = "egress") -> dict:
    """Validate a manifest.egress object; returns {"roles": …, "features": …}."""
    if not isinstance(egress, dict):
        raise invalid(f"{where}: must be an object")
    if set(egress) != {"version", "roles", "features"}:
        raise invalid(f"{where}: keys must be version, roles, features")
    if egress["version"] != 1 or isinstance(egress["version"], bool):
        raise invalid(f"{where}.version: must be 1")
    roles = validate_role_map(cfg, egress["roles"], f"{where}.roles")
    feats = egress["features"]
    if not isinstance(feats, dict):
        raise invalid(f"{where}.features: must be an object")
    names = cfg.feature_names if cfg else list(CONTRACT_FEATURES)
    features: dict[str, dict[str, list[dict]]] = {}
    for name, role_map in feats.items():
        if name not in names:
            raise invalid(f"{where}.features: unknown feature {name!r}")
        features[name] = validate_role_map(cfg, role_map, f"{where}.features.{name}")
    return {"roles": roles, "features": features}


EMPTY_EGRESS: dict = {"roles": {}, "features": {}}


def load_release(cfg: Config, release_dir: str | None) -> tuple[str | None, dict]:
    """(version, validated egress) of a release directory; `none` or a missing dir = empty."""
    if release_dir is None or release_dir == "none":
        return None, EMPTY_EGRESS
    d = Path(release_dir)
    if not d.exists():
        return None, EMPTY_EGRESS
    manifest_path = d / "manifest.json"
    try:
        manifest = read_json(manifest_path, "manifest")
    except FileNotFoundError as exc:
        raise invalid(f"{manifest_path}: missing") from exc
    if not isinstance(manifest, dict) or "egress" not in manifest:
        raise invalid(f"{manifest_path}: no egress section")
    version = manifest.get("version")
    if not isinstance(version, str) or not SEMVER_RE.match(version):
        raise invalid(f"{manifest_path}: bad version")
    return version, validate_egress(cfg, manifest["egress"], f"{manifest_path}:egress")


def load_features(cfg: Config) -> tuple[dict[str, bool], list[str]]:
    path = cfg.p("features")
    try:
        raw = read_json(path, "features")
    except FileNotFoundError:
        return dict(cfg.feature_defaults), []
    if not isinstance(raw, dict) or raw.get("v") != 1:
        raise invalid(f"{path}: expected {{\"v\":1,…}}")
    flags = raw.get("features")
    if not isinstance(flags, dict):
        raise invalid(f"{path}: features must be an object")
    out = dict(cfg.feature_defaults)
    for name, value in flags.items():
        if name not in cfg.feature_names:
            raise invalid(f"{path}: unknown feature {name!r}")
        if not isinstance(value, bool):
            raise invalid(f"{path}: features.{name} must be true or false")
        out[name] = value
    ics = raw.get("ics_hosts", [])
    if not isinstance(ics, list) or len(ics) > MAX_ICS_HOSTS:
        raise invalid(f"{path}: ics_hosts must be a list of at most {MAX_ICS_HOSTS} host names")
    hosts: list[str] = []
    for h in ics:
        problem = host_problem(h, allow_wildcard=False)
        if problem:
            raise invalid(f"{path}: ics_hosts: {problem}")
        if h not in hosts:
            hosts.append(h)
    return out, hosts


def load_pinned(cfg: Config) -> list[dict]:
    path = cfg.p("pinned")
    try:
        raw = read_json(path, "pinned")
    except FileNotFoundError as exc:
        raise precondition(f"missing {path} (written by the Ansible role egress)") from exc
    if not isinstance(raw, dict) or raw.get("v") != 1 or not isinstance(raw.get("entries"), list):
        raise invalid(f"{path}: expected {{\"v\":1,\"entries\":[…]}}")
    return [validate_entry(cfg, e, f"{path}[{i}]") for i, e in enumerate(raw["entries"])]


# --------------------------------------------------------------------------- allowlist


def effective_entries(cfg: Config, egress: dict, flags: dict[str, bool], ics_hosts: list[str],
                      pinned: list[dict]) -> list[dict]:
    """Union of base, enabled features, ICS hosts, office entries and pinned entries."""
    merged: dict[tuple[str, str, int], dict] = {}

    def add(role: str, host: str, port: int, purpose: str, source: str) -> None:
        key = (role, host, port)
        item = merged.setdefault(key, {"role": role, "host": host, "port": port,
                                       "purpose": purpose, "sources": []})
        if source not in item["sources"]:
            item["sources"].append(source)

    for role, entries in egress["roles"].items():
        for e in entries:
            add(role, e["host"], e["port"], e["purpose"], "base")
    for name in cfg.feature_names:
        if not flags.get(name):
            continue
        for role, entries in egress["features"].get(name, {}).items():
            for e in entries:
                add(role, e["host"], e["port"], e["purpose"], f"feature:{name}")
        if name == "ics":
            for h in ics_hosts:
                add(cfg.ics_role, h, 443, ICS_PURPOSE, "feature:ics")
    for e in cfg.office_entries:
        add(e["role"], e["host"], e["port"], e["purpose"], "office")
    for e in pinned:
        add(e["role"], e["host"], e["port"], e["purpose"], "pinned")
    return sorted(merged.values(), key=lambda x: (cfg.roles.index(x["role"]), x["host"], x["port"]))


def by_role(cfg: Config, entries: list[dict]) -> dict[str, list[dict]]:
    out: dict[str, list[dict]] = {r: [] for r in cfg.roles}
    for e in entries:
        out[e["role"]].append(e)
    return out


# --------------------------------------------------------------------------- render


def uid_of(name: str) -> int | None:
    try:
        return pwd.getpwnam(name).pw_uid
    except KeyError:
        return None


def acl_text(role: str, mode: str, release: str | None, hosts: list[str]) -> str:
    domains = "".join(f"\n    - {json.dumps(h)}" for h in hosts) if hosts else " []"
    return fill("smokescreen-acl.yaml.in", {
        "GENERATOR": GENERATOR, "ROLE": role, "RELEASE": release or "none", "MODE": mode,
        "ACTION": "enforce" if mode == "enforce" else "report", "ALLOWED_DOMAINS": domains,
    })


def proxy_config_text(cfg: Config, role: str) -> str:
    if role == "host":
        listen_ip = cfg.host_proxy["listen"]
        port = cfg.host_proxy["port"]
        acl_file = str(cfg.p("proxy_dir") / "host" / "acl.yaml")
        resolver = "# Host instance: system resolver (systemd-resolved, DNS over TLS)."
    else:
        listen_ip = cfg.container["listen"]
        port = cfg.container["port"]
        acl_file = cfg.container["acl_path"]
        resolver = f"resolver_addresses: [{json.dumps(cfg.container['resolver'])}]"
    return fill("smokescreen.yaml.in", {
        "GENERATOR": GENERATOR, "ROLE": role, "LISTEN_IP": listen_ip, "LISTEN_PORT": str(int(port)),
        "ACL_FILE": acl_file, "RESOLVER": resolver,
    })


def nft_set(items: Iterable[str]) -> str:
    return ", ".join(items)


def nft_text(cfg: Config, release: str | None, roles: dict[str, list[dict]]) -> tuple[str, list[str]]:
    """Render egress.nft; returns (text, warnings)."""
    warnings: list[str] = []
    mode = cfg.mode
    verdict = "drop" if mode == "enforce" else "accept"
    prefix = "legatto-egress-deny" if mode == "enforce" else "legatto-egress-observe"

    client_uids: list[str] = []
    for name in cfg.host_proxy["clients"]:
        uid = uid_of(name)
        if uid is None:
            warnings.append(f"host proxy client {name!r} does not exist; skipped")
        else:
            client_uids.append(str(uid))
    if not client_uids:
        raise invalid("no host proxy client user exists")

    host_rules: list[str] = []
    proxy_uid = uid_of(cfg.host_proxy["user"])
    host_ports = sorted({e["port"] for e in roles["host"]})
    if proxy_uid is None:
        raise precondition(f"user {cfg.host_proxy['user']!r} does not exist (role egress creates it)")
    if host_ports:
        host_rules.append("\t\t# Host proxy uplink: ports of the host role entries.")
        host_rules.append(f"\t\tmeta skuid {proxy_uid} tcp dport {{ {nft_set(map(str, host_ports))} }} accept")
    resolver_uid = uid_of(cfg.system_users["resolver"])
    dot4 = [a for a in cfg.dot_resolvers if ipaddress.ip_address(a).version == 4]
    dot6 = [a for a in cfg.dot_resolvers if ipaddress.ip_address(a).version == 6]
    if resolver_uid is None:
        warnings.append(f"resolver user {cfg.system_users['resolver']!r} does not exist; DNS rules skipped")
    else:
        host_rules.append("\t\t# systemd-resolved: DNS over TLS to the configured resolvers only.")
        for fam, addrs in (("ip", dot4), ("ip6", dot6)):
            if addrs:
                host_rules.append(f"\t\tmeta skuid {resolver_uid} {fam} daddr {{ {nft_set(addrs)} }} "
                                  "tcp dport { 53, 853 } accept")
                host_rules.append(f"\t\tmeta skuid {resolver_uid} {fam} daddr {{ {nft_set(addrs)} }} "
                                  "udp dport 53 accept")
    ntp_uid = uid_of(cfg.system_users["ntp"])
    if ntp_uid is None:
        warnings.append(f"NTP user {cfg.system_users['ntp']!r} does not exist; NTP rules skipped")
    else:
        host_rules.append("\t\t# chrony: NTP and NTS key establishment.")
        host_rules.append(f"\t\tmeta skuid {ntp_uid} udp dport 123 accept")
        host_rules.append(f"\t\tmeta skuid {ntp_uid} tcp dport 4460 accept")
    wg_uid = uid_of(cfg.system_users["wireguard"])
    if wg_uid is None:
        warnings.append(f"WireGuard user {cfg.system_users['wireguard']!r} does not exist; rule skipped")
    else:
        host_rules.append("\t\t# tailscaled: direct WireGuard paths to tailnet peers.")
        host_rules.append(f"\t\tmeta skuid {wg_uid} udp sport {int(cfg.nft['wireguard_port'])} accept")
    host_rules.extend([
        "\t\t# DHCPv4/DHCPv6 lease renewal and IPv6 neighbour discovery.",
        "\t\tudp sport 68 udp dport 67 accept",
        "\t\tudp sport 546 udp dport 547 accept",
        "\t\ticmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, "
        "mld2-listener-report } accept",
    ])

    fwd_rules: list[str] = []
    ext_if = cfg.nft["egress_ext_bridge"]
    resolver_ip, _, resolver_port = cfg.container["resolver"].rpartition(":")
    active_ips: list[str] = []
    for role in cfg.container_roles:
        ports = sorted({e["port"] for e in roles[role]})
        proxy = cfg.container_proxies[role]
        if not ports:
            fwd_rules.append(f"\t\t# {proxy['service']} ({role}): empty allowlist, no uplink.")
            continue
        active_ips.append(proxy["ext_ip"])
        fwd_rules.append(f"\t\t# {proxy['service']} ({role}).")
        fwd_rules.append(f"\t\tiifname \"{ext_if}\" ip saddr {proxy['ext_ip']} "
                         f"tcp dport {{ {nft_set(map(str, ports))} }} accept")
    if active_ips:
        fwd_rules.append("\t\t# Name resolution of the active proxies.")
        for proto in ("udp", "tcp"):
            fwd_rules.append(f"\t\tiifname \"{ext_if}\" ip saddr {{ {nft_set(active_ips)} }} "
                             f"ip daddr {resolver_ip} {proto} dport {int(resolver_port)} accept")

    local_ifaces = [cfg.nft["tailscale_if"], *cfg.nft["docker_bridges"]]
    text = fill("egress.nft.in", {
        "GENERATOR": GENERATOR, "RELEASE": release or "none", "MODE": mode,
        "HOST_PROXY_IP": cfg.host_proxy["listen"], "HOST_PROXY_PORT": str(int(cfg.host_proxy["port"])),
        "HOST_PROXY_CLIENT_UIDS": nft_set(client_uids), "LOG_PREFIX": prefix, "DENY_VERDICT": verdict,
        "LOCAL_IFACES": nft_set(f'"{i}"' for i in local_ifaces),
        "HOST_SERVICE_RULES": "\n".join(host_rules), "PROXY_FWD_RULES": "\n".join(fwd_rules),
        "METADATA_IP": cfg.nft["metadata_ip"],
    })
    return text, warnings


def render(cfg: Config, release_dir: str | None, out: Path) -> dict:
    release, egress = load_release(cfg, release_dir)
    flags, ics_hosts = load_features(cfg)
    pinned = load_pinned(cfg)
    entries = effective_entries(cfg, egress, flags, ics_hosts, pinned)
    roles = by_role(cfg, entries)
    nft, warnings = nft_text(cfg, release, roles)

    allowlist = {
        "v": 1,
        "generator": GENERATOR,
        "release": release,
        "mode": cfg.mode,
        "features_active": [f for f in cfg.feature_names if flags.get(f)],
        "roles_active": [r for r in cfg.roles if roles[r]],
        "entries": entries,
        "egress": egress,
    }
    files: dict[str, bytes] = {
        "allowlist.json": canonical(allowlist),
        "features.json": canonical({"v": 1, "features": flags, "ics_hosts": ics_hosts}),
        "pinned.json": canonical({"v": 1, "entries": pinned}),
        "egress.nft": nft.encode("utf-8"),
    }
    for role in cfg.roles:
        hosts = sorted({e["host"] for e in roles[role]})
        files[f"proxy/{role}/acl.yaml"] = acl_text(role, cfg.mode, release, hosts).encode("utf-8")
        files[f"proxy/{role}/smokescreen.yaml"] = proxy_config_text(cfg, role).encode("utf-8")

    out.mkdir(parents=True, exist_ok=True)
    for rel, data in files.items():
        write_atomic(out / rel, data, 0o644)
    for w in warnings:
        log(f"warning: {w}")
    return {"release": release, "mode": cfg.mode, "out": str(out), "files": sorted(files),
            "roles_active": allowlist["roles_active"], "features_active": allowlist["features_active"],
            "entries": len(entries), "warnings": warnings}


# --------------------------------------------------------------------------- check


def nft_check(cfg: Config, nft_file: Path) -> None:
    if shutil.which("nft") is None:
        raise precondition("nft not found")
    fam, table = cfg.nft["family"], cfg.nft["table"]
    out_chain, fwd_chain = cfg.nft["chain_out"], cfg.nft["chain_fwd"]
    script = (
        f"table {fam} {table} {{\n\tchain {out_chain} {{\n\t}}\n\tchain {fwd_chain} {{\n\t}}\n}}\n"
        f"flush chain {fam} {table} {out_chain}\nflush chain {fam} {table} {fwd_chain}\n"
        f"include \"{nft_file}\"\n"
    )
    with tempfile.NamedTemporaryFile("w", suffix=".nft", delete=False) as fh:
        fh.write(script)
        tmp = fh.name
    try:
        res = subprocess.run(["nft", "-c", "-f", tmp], capture_output=True, text=True, check=False)
    finally:
        os.unlink(tmp)
    if res.returncode != 0:
        raise invalid(f"nft -c rejected {nft_file}: {res.stderr.strip()}")


def check(cfg: Config, d: Path) -> dict:
    """Validate a rendered directory: data, ACL syntax, consistency, nft -c."""
    try:
        allow = read_json(d / "allowlist.json", "allowlist")
    except FileNotFoundError as exc:
        raise invalid(f"{d}: allowlist.json missing (run render first)") from exc
    if not isinstance(allow, dict) or allow.get("v") != 1:
        raise invalid(f"{d}/allowlist.json: unsupported version")
    if allow.get("mode") != cfg.mode:
        raise invalid(f"{d}: rendered for mode {allow.get('mode')!r}, config says {cfg.mode!r}")
    validate_egress(cfg, {"version": 1, **allow["egress"]}, f"{d}/allowlist.json:egress")
    entries = allow.get("entries")
    if not isinstance(entries, list):
        raise invalid(f"{d}/allowlist.json: entries missing")
    for i, e in enumerate(entries):
        validate_entry(cfg, {k: e.get(k) for k in ("role", "host", "port", "purpose")},
                       f"{d}/allowlist.json entries[{i}]")
    roles = by_role(cfg, entries)
    release = allow.get("release")
    for role in cfg.roles:
        hosts = sorted({e["host"] for e in roles[role]})
        expect = {
            f"proxy/{role}/acl.yaml": acl_text(role, cfg.mode, release, hosts),
            f"proxy/{role}/smokescreen.yaml": proxy_config_text(cfg, role),
        }
        for rel, text in expect.items():
            try:
                actual = (d / rel).read_text(encoding="utf-8")
            except FileNotFoundError as exc:
                raise invalid(f"{d}/{rel}: missing") from exc
            if actual != text:
                raise invalid(f"{d}/{rel}: does not match allowlist.json")
            if rel.endswith("acl.yaml"):
                validate_acl_syntax(d / rel)
    nft_expect, _ = nft_text(cfg, release, roles)
    nft_path = d / "egress.nft"
    if not nft_path.is_file() or nft_path.read_text(encoding="utf-8") != nft_expect:
        raise invalid(f"{nft_path}: missing or does not match allowlist.json")
    nft_check(cfg, nft_path)
    return {"dir": str(d), "ok": True, "roles_active": allow.get("roles_active", [])}


def validate_acl_syntax(path: Path) -> None:
    """Re-check the generated ACL against Smokescreen v0.1.0 glob rules."""
    lines = path.read_text(encoding="utf-8").splitlines()
    if "version: v1" not in lines or "services: []" not in lines:
        raise invalid(f"{path}: not a Smokescreen v1 ACL")
    action = [ln.split(":", 1)[1].strip() for ln in lines if ln.startswith("  action:")]
    if action not in (["enforce"], ["report"]):
        raise invalid(f"{path}: action must be enforce or report")
    for ln in lines:
        if ln.startswith("    - "):
            glob = json.loads(ln[6:])
            if glob in ("*", "*.") or ("*" in glob and not glob.startswith("*.")) or "*" in glob[2:]:
                raise invalid(f"{path}: invalid glob {glob!r}")
            problem = host_problem(glob)
            if problem:
                raise invalid(f"{path}: {problem}")


# --------------------------------------------------------------------------- diff


def triples(egress: dict) -> dict[tuple[str, str, str, int], dict]:
    out: dict[tuple[str, str, str, int], dict] = {}
    for role, entries in egress["roles"].items():
        for e in entries:
            out[("base", role, e["host"], e["port"])] = e
    for name, role_map in egress["features"].items():
        for role, entries in role_map.items():
            for e in entries:
                out[(f"feature:{name}", role, e["host"], e["port"])] = e
    return out


def diff(cfg: Config, from_dir: str, to_dir: str) -> tuple[dict, int]:
    _, old = load_release(cfg, from_dir)
    new_version, new = load_release(cfg, to_dir)
    flags, _ = load_features(cfg)
    pinned = load_pinned(cfg)
    old_t, new_t = triples(old), triples(new)
    old_base = {(r, h, p) for (s, r, h, p) in old_t if s == "base"}

    def active(scope: str) -> bool:
        return scope == "base" or bool(flags.get(scope.split(":", 1)[1]))

    def row(key: tuple[str, str, str, int]) -> dict:
        scope, role, host, port = key
        return {"role": role, "host": host, "port": port, "source": scope, "active": active(scope)}

    added, widening_rows = [], []
    for key in sorted(set(new_t) - set(old_t)):
        scope, role, host, port = key
        added.append(row(key))
        # An entry added to a feature is covered when the same (role, host,
        # port) was already always-on; everything else is a widening.
        covered = scope != "base" and (role, host, port) in old_base
        if not covered:
            widening_rows.append(row(key))
    removed = [row(k) for k in sorted(set(old_t) - set(new_t))]
    new_base = {(r, h, p) for (s, r, h, p) in new_t if s == "base"}
    pinned_removed = [
        {"role": e["role"], "host": e["host"], "port": e["port"], "purpose": e["purpose"]}
        for e in pinned
        if (e["role"], e["host"], e["port"]) in old_base and (e["role"], e["host"], e["port"]) not in new_base
    ]
    result = {
        "widening": bool(widening_rows),
        "added": added,
        "removed": removed,
        "widening_entries": widening_rows,
        "pinned_removed": pinned_removed,
        "to_release": new_version,
    }
    if pinned_removed:
        return result, EXIT_PINNED_REMOVED
    if widening_rows:
        return result, EXIT_WIDENING
    return result, EXIT_OK


# --------------------------------------------------------------------------- apply


@contextlib.contextmanager
def locked(cfg: Config):
    path = cfg.p("lock")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(path), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        deadline = time.monotonic() + LOCK_TIMEOUT_S
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError as exc:
                if exc.errno not in (errno.EAGAIN, errno.EACCES) or time.monotonic() > deadline:
                    raise EgressError("another legatto-egress holds the lock", EXIT_LOCKED) from exc
                time.sleep(0.2)
        yield
    finally:
        os.close(fd)


def require_root() -> None:
    if os.geteuid() != 0:
        raise precondition("must run as root")


def parse_actor(raw: str | None) -> dict:
    if raw is None:
        return {"kind": "system", "id": "legatto-egress"}
    try:
        actor = json.loads(raw)
    except ValueError as exc:
        raise EgressError(f"--actor: not JSON: {exc}", EXIT_USAGE) from exc
    if not isinstance(actor, dict) or actor.get("kind") not in ACTOR_KINDS:
        raise EgressError(f"--actor: object with kind in {list(ACTOR_KINDS)} required", EXIT_USAGE)
    return actor


def audit(cfg: Config, event: str, actor: dict, params: dict) -> None:
    cli = cfg.p("audit_cli")
    res = subprocess.run(
        [str(cli), "append", "--cat", "egress", "--event", event, "--actor",
         json.dumps(actor, separators=(",", ":")), "--params", json.dumps(params, separators=(",", ":"))],
        capture_output=True, text=True, check=False)
    if res.returncode != 0:
        raise EgressError(f"legatto-audit append {event} failed ({res.returncode}): {res.stderr.strip()}")


def nft_load(cfg: Config) -> None:
    fam, table = cfg.nft["family"], cfg.nft["table"]
    script = (f"flush chain {fam} {table} {cfg.nft['chain_out']}\n"
              f"flush chain {fam} {table} {cfg.nft['chain_fwd']}\n"
              f"include \"{cfg.p('nft_file')}\"\n")
    with tempfile.NamedTemporaryFile("w", suffix=".nft", delete=False) as fh:
        fh.write(script)
        tmp = fh.name
    try:
        res = subprocess.run(["nft", "-f", tmp], capture_output=True, text=True, check=False)
    finally:
        os.unlink(tmp)
    if res.returncode != 0:
        raise EgressError(f"nft -f failed: {res.stderr.strip()}")


def nft_table_present(cfg: Config) -> bool:
    res = subprocess.run(["nft", "list", "chain", cfg.nft["family"], cfg.nft["table"], cfg.nft["chain_out"]],
                         capture_output=True, text=True, check=False)
    return res.returncode == 0


def unit_loaded(unit: str) -> bool:
    if shutil.which("systemctl") is None:
        return False
    res = subprocess.run(["systemctl", "show", "-p", "LoadState", "--value", unit],
                         capture_output=True, text=True, check=False)
    return res.returncode == 0 and res.stdout.strip() == "loaded"


def docker_available() -> bool:
    if shutil.which("docker") is None:
        return False
    return subprocess.run(["docker", "info", "--format", "{{.ID}}"], capture_output=True,
                          check=False).returncode == 0


def proxy_containers(cfg: Config, role: str, all_states: bool = True) -> list[str]:
    service = cfg.container_proxies[role]["service"]
    cmd = ["docker", "ps", "-q", "--no-trunc",
           "--filter", f"label=com.docker.compose.project={cfg.compose_project}",
           "--filter", f"label=com.docker.compose.service={service}"]
    if all_states:
        cmd.insert(2, "-a")
    res = subprocess.run(cmd, capture_output=True, text=True, check=False)
    return res.stdout.split() if res.returncode == 0 else []


def install_files(cfg: Config, src: Path) -> tuple[dict[str, bytes | None], list[str]]:
    """Copy rendered files to their targets; returns (backup, changed proxy roles)."""
    targets: dict[str, Path] = {"egress.nft": cfg.p("nft_file")}
    for role in cfg.roles:
        for name in ("acl.yaml", "smokescreen.yaml"):
            targets[f"proxy/{role}/{name}"] = cfg.p("proxy_dir") / role / name
    backup: dict[str, bytes | None] = {}
    changed_roles: list[str] = []
    for rel, dst in targets.items():
        new = (src / rel).read_bytes()
        old = dst.read_bytes() if dst.exists() else None
        backup[str(dst)] = old
        if old != new:
            write_atomic(dst, new, 0o644)
            if rel.startswith("proxy/"):
                role = rel.split("/")[1]
                if role not in changed_roles:
                    changed_roles.append(role)
    rendered = cfg.p("rendered_dir")
    rendered.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(rendered, 0o700)
    for name in ("allowlist.json", "features.json", "pinned.json", "egress.nft"):
        write_atomic(rendered / name, (src / name).read_bytes(), 0o600)
    return backup, changed_roles


def restore_files(backup: dict[str, bytes | None]) -> None:
    for path, data in backup.items():
        p = Path(path)
        if data is None:
            with contextlib.suppress(FileNotFoundError):
                p.unlink()
        else:
            write_atomic(p, data, 0o644)


def restart_proxies(cfg: Config, roles: list[str]) -> list[str]:
    notes: list[str] = []
    if "host" in roles:
        unit = cfg.host_proxy["unit"]
        if unit_loaded(unit):
            res = subprocess.run(["systemctl", "restart", unit], capture_output=True, text=True, check=False)
            if res.returncode != 0:
                raise EgressError(f"systemctl restart {unit} failed: {res.stderr.strip()}")
        else:
            notes.append(f"{unit} not installed; host proxy not restarted")
    container_roles = [r for r in cfg.container_roles if r in roles]
    if container_roles:
        if not docker_available():
            notes.append("docker not available; container proxies not restarted")
            return notes
        for role in container_roles:
            ids = proxy_containers(cfg, role, all_states=False)
            if not ids:
                notes.append(f"{cfg.container_proxies[role]['service']} not running; picks up the ACL at start")
                continue
            res = subprocess.run(["docker", "restart", "-t", "5", *ids], capture_output=True, text=True,
                                 check=False)
            if res.returncode != 0:
                raise EgressError(f"docker restart {cfg.container_proxies[role]['service']} failed: "
                                  f"{res.stderr.strip()}")
    return notes


def apply(cfg: Config, release_dir: str | None, actor: dict) -> dict:
    require_root()
    if shutil.which("nft") is None:
        raise precondition("nft not found")
    if not os.access(cfg.p("audit_cli"), os.X_OK):
        raise precondition(f"{cfg.p('audit_cli')} missing (net lane)")
    with locked(cfg):
        if not nft_table_present(cfg):
            raise precondition(f"nft chain {cfg.nft['table']}/{cfg.nft['chain_out']} missing (firewall role)")
        staging = Path(tempfile.mkdtemp(prefix=".staging-", dir=str(cfg.p("etc"))))
        try:
            rendered = render(cfg, release_dir, staging)
            check(cfg, staging)
            backup, changed = install_files(cfg, staging)
            try:
                nft_load(cfg)
            except EgressError:
                restore_files(backup)
                with contextlib.suppress(EgressError):
                    nft_load(cfg)
                raise
            notes = restart_proxies(cfg, changed)
        finally:
            shutil.rmtree(staging, ignore_errors=True)
        now = utc_now()
        state = {"v": 1, "release": rendered["release"], "mode": cfg.mode, "at": now, "ok": True,
                 "roles_active": rendered["roles_active"], "features_active": rendered["features_active"]}
        write_state(cfg, "applied.json", state)
        audit(cfg, "egress.applied", actor, {
            "release": rendered["release"], "mode": cfg.mode, "entries": rendered["entries"],
            "roles_active": rendered["roles_active"], "features_active": rendered["features_active"],
            "restarted": changed,
        })
        write_status(cfg, denied=None)
    return {**rendered, "applied_at": now, "restarted": changed, "notes": notes}


