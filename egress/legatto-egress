TEMPLATE_DIR = Path(__file__).resolve().parent / "templates"

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2
EXIT_LOCKED = 3
EXIT_PRECONDITION = 4
EXIT_WIDENING = 40
EXIT_PINNED_REMOVED = 41
EXIT_INVALID = 42
EXIT_SELFTEST_FAILED = 43

LOCK_TIMEOUT_S = 10
DENIED_WINDOW_S = 300
DENIED_MAX = 999_999  # Kuma field eg_deny: ^[0-9]{1,6}$
DENIED_AUDIT_INTERVAL_S = 900
MAX_ICS_HOSTS = 50
MAX_ENTRIES_PER_ROLE = 200

HOST_RE = re.compile(r"^(\*\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
ALLOWED_PORTS = (80, 443)
PORT80_ROLES = ("host",)  # plain HTTP only for signed APT repositories
ACTOR_KINDS = ("office-admin", "vendor", "system", "bootstrap")
SEMVER_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$")

