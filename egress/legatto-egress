    "githubusercontent.com", "gitlab.io", "global.ssl.fastly.net", "googleapis.com",
    "herokuapp.com", "netlify.app", "ngrok-free.app", "ngrok.io", "onrender.com", "pages.dev",
    "r2.cloudflarestorage.com", "r2.dev", "run.app", "s3.amazonaws.com", "storage.googleapis.com",
    "supabase.co", "supabase.in", "trycloudflare.com", "vercel.app", "web.app", "wordpress.com",
