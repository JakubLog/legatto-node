def read_state(cfg: Config, name: str) -> dict:
    path = cfg.p("state_dir") / name
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_state(cfg: Config, name: str, data: dict) -> None:
    d = cfg.p("state_dir")
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_atomic(d / name, canonical(data), 0o600)


def nft_counters(cfg: Config) -> dict[str, int] | None:
    if shutil.which("nft") is None:
        return None
    res = subprocess.run(["nft", "-j", "list", "counters", "table", cfg.nft["family"], cfg.nft["table"]],
                         capture_output=True, text=True, check=False)
    if res.returncode != 0:
        return None
    out: dict[str, int] = {}
    with contextlib.suppress(ValueError, KeyError, TypeError):
        for item in json.loads(res.stdout).get("nftables", []):
            c = item.get("counter")
            if c and str(c.get("name", "")).startswith("egress_denied_"):
                out[c["name"]] = int(c["packets"])
    return out


def journal_denies(cfg: Config, since_epoch: int) -> dict[str, int]:
    """Smokescreen decisions with enforce_would_deny=true, per role, since a time."""
    if shutil.which("journalctl") is None:
        return {}
    matches = [f"_SYSTEMD_UNIT={cfg.host_proxy['unit']}"]
    names: dict[str, str] = {}
    if docker_available():
        for role in cfg.container_roles:
            for cid in proxy_containers(cfg, role):
                res = subprocess.run(["docker", "inspect", "--format", "{{.Name}}", cid],
                                     capture_output=True, text=True, check=False)
                name = res.stdout.strip().lstrip("/")
                if name:
                    names[name] = role
                    matches += ["+", f"CONTAINER_NAME={name}"]
    res = subprocess.run(["journalctl", "--no-pager", "-o", "json", f"--since=@{since_epoch}", *matches],
                         capture_output=True, text=True, check=False)
    counts: dict[str, int] = {}
    for line in res.stdout.splitlines():
        try:
            rec = json.loads(line)
            msg = rec.get("MESSAGE")
            if isinstance(msg, list):
                msg = bytes(msg).decode("utf-8", "replace")
            event = json.loads(msg)
        except (ValueError, TypeError):
            continue
        if event.get("msg") != "CANONICAL-PROXY-DECISION" or event.get("enforce_would_deny") is not True:
            continue
        role = names.get(rec.get("CONTAINER_NAME", ""), "host")
        counts[role] = counts.get(role, 0) + 1
    return counts


def counter_delta(current: dict[str, int], base: dict[str, int]) -> dict[str, int]:
    """Per-counter growth; a counter below its baseline was reset (table reload)."""
    out: dict[str, int] = {}
    for name, value in current.items():
        old = base.get(name, value)
        out[name.replace("egress_denied_", "nft_")] = value - old if value >= old else value
    return out


def denied_counts(cfg: Config, now: int) -> tuple[int, dict[str, int], dict[str, int]]:
    """(denied_5m, by source over 5 min, new since the previous run).

    Sources: nft deny counters (host, forward, proxy port) and Smokescreen
    decisions with enforce_would_deny=true (host and container proxies). In
    observe mode these are would-be denials. Only numbers leave this function.
    """
    st = read_state(cfg, "counters.json")
    samples = [s for s in st.get("samples", [])
               if isinstance(s, dict) and now - int(s.get("ts", 0)) <= 3 * DENIED_WINDOW_S]
    current = nft_counters(cfg) or {}
    prev_run = samples[-1] if samples else None
    old = [s for s in samples if now - s["ts"] >= DENIED_WINDOW_S]
    baseline = old[-1] if old else (samples[0] if samples else {"counters": current})
    window = counter_delta(current, baseline["counters"])
    fresh = counter_delta(current, prev_run["counters"] if prev_run else current)
    for role, n in journal_denies(cfg, now - DENIED_WINDOW_S).items():
        window[f"proxy_{role}"] = n
    since_prev = int(prev_run["ts"]) if prev_run else now - 60
    for role, n in journal_denies(cfg, since_prev).items():
        fresh[f"proxy_{role}"] = n
    samples.append({"ts": now, "counters": current})
    write_state(cfg, "counters.json", {"v": 1, "samples": samples})
    window = {k: v for k, v in window.items() if v > 0}
    fresh = {k: v for k, v in fresh.items() if v > 0}
    return min(sum(window.values()), DENIED_MAX), window, fresh


def host_proxy_state(cfg: Config) -> str:
    if shutil.which("systemctl") is None:
        return "unknown"
    res = subprocess.run(["systemctl", "is-active", cfg.host_proxy["unit"]], capture_output=True, text=True,
                         check=False)
    return res.stdout.strip() or "unknown"


def write_status(cfg: Config, denied: tuple[int, dict[str, int]] | None) -> dict:
    applied = read_state(cfg, "applied.json")
    previous = read_status(cfg)
    if denied is None:
        denied_5m = int(previous.get("denied_5m", 0)) if isinstance(previous.get("denied_5m"), int) else 0
    else:
        denied_5m = denied[0]
    proxy = host_proxy_state(cfg)
    nft_ok = shutil.which("nft") is not None and nft_table_present(cfg)
    status = {
        "v": 1, "component": "egress", "ts": utc_now(),
        "ok": bool(applied.get("ok")) and applied.get("mode") == cfg.mode and proxy == "active" and nft_ok,
        "mode": cfg.mode,
        "release": applied.get("release"),
        "denied_5m": denied_5m,
        "last_apply_at": applied.get("at"),
        "roles_active": applied.get("roles_active", []),
        "features_active": applied.get("features_active", []),
        "host_proxy": proxy,
    }
    try:
        gid: int | None = grp.getgrnam(cfg.status_group).gr_gid
    except KeyError:
        gid = None
        log(f"warning: group {cfg.status_group} missing; status file stays root-only")
    write_atomic(cfg.p("status_dir") / "egress.json", canonical(status), 0o640, gid)
    return status


def read_status(cfg: Config) -> dict:
    try:
        data = json.loads((cfg.p("status_dir") / "egress.json").read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def status(cfg: Config, write: bool) -> dict:
    if not write:
        current = read_status(cfg)
        if not current:
            raise precondition("no status yet (legatto-egress status --write runs from the timer)")
        return current
    require_root()
    with locked(cfg):
        now = int(time.time())
        total, window, fresh = denied_counts(cfg, now)
        result = write_status(cfg, (total, window))
        # egress.denied goes to the audit log in aggregate (counts only, never
        # host names), at most once per DENIED_AUDIT_INTERVAL_S.
        st = read_state(cfg, "denied-audit.json")
        pending = {k: int(v) for k, v in st.get("pending", {}).items() if isinstance(v, int)}
        for k, v in fresh.items():
            pending[k] = pending.get(k, 0) + v
        last_audit = int(st.get("last_audit", 0))
        if sum(pending.values()) > 0 and now - last_audit >= DENIED_AUDIT_INTERVAL_S:
            since = dt.datetime.fromtimestamp(last_audit, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") \
                if last_audit else None
            audit(cfg, "egress.denied", {"kind": "system", "id": "legatto-egress"},
                  {"count": min(sum(pending.values()), DENIED_MAX), "by_source": pending,
                   "since": since, "mode": cfg.mode})
            pending, last_audit = {}, now
        write_state(cfg, "denied-audit.json", {"v": 1, "pending": pending, "last_audit": last_audit})
    return result


# --------------------------------------------------------------------------- selftest


def proxy_connect(host: str, port: int, target: str, timeout: float = 5.0) -> int | None:
    """CONNECT through an HTTP proxy; returns the status code or None on socket failure."""
    try:
        with socket.create_connection((host, port), timeout=timeout) as s:
            s.sendall(f"CONNECT {target} HTTP/1.1\r\nHost: {target}\r\n\r\n".encode())
            data = s.recv(256).decode("latin-1", "replace")
    except OSError:
        return None
    m = re.match(r"HTTP/1\.[01] (\d{3})", data)
    return int(m.group(1)) if m else None


def connect_as(uid: int, host: str, port: int, timeout: float = 3.0) -> bool:
    code = ("import socket,sys\n"
            f"s=socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.settimeout({timeout})\n"
            f"sys.exit(0 if s.connect_ex(({host!r},{port}))==0 else 1)\n")
    res = subprocess.run([sys.executable, "-I", "-c", code], user=uid, group=uid, extra_groups=[],
                         capture_output=True, check=False, timeout=timeout + 5)
    return res.returncode == 0


def selftest(cfg: Config) -> tuple[dict, int]:
    require_root()
    enforce = cfg.mode == "enforce"
    checks: dict[str, dict] = {}

    def record(cid: str, ok: bool, msg: str, info: bool = False) -> None:
        checks[cid] = {"ok": ok, "msg": msg, **({"info": True} if info else {})}

    applied = read_state(cfg, "applied.json")
    # E1: chains loaded and terminal verdict matches the mode.
    res = subprocess.run(["nft", "-j", "list", "chain", cfg.nft["family"], cfg.nft["table"], cfg.nft["chain_out"]],
                         capture_output=True, text=True, check=False)
    verdicts: list[str] = []
    if res.returncode == 0:
        for item in json.loads(res.stdout).get("nftables", []):
            rule = item.get("rule")
            if rule:
                verdicts.append(json.dumps(rule.get("expr", [])[-1:]))
    want = "drop" if enforce else "accept"
    record("E1", bool(verdicts) and want in verdicts[-1] and applied.get("mode") == cfg.mode,
           f"egress_out has {len(verdicts)} rules, terminal verdict {want}, applied mode {applied.get('mode')}")
    # E2: host proxy active and listening.
    proxy_ip, proxy_port = cfg.host_proxy["listen"], int(cfg.host_proxy["port"])
    state = host_proxy_state(cfg)
    try:
        socket.create_connection((proxy_ip, proxy_port), timeout=3).close()
        listening = True
    except OSError:
        listening = False
    record("E2", state == "active" and listening, f"{cfg.host_proxy['unit']} {state}, listening={listening}")
    # E3: an allowlisted (pinned) host passes the host proxy.
    pinned = [e for e in load_pinned(cfg) if e["role"] == "host" and e["port"] == 443]
    if pinned:
        target = f"{pinned[0]['host']}:443"
        code = proxy_connect(proxy_ip, proxy_port, target)
        if code == 200:
            record("E3", True, f"CONNECT {target} -> 200")
        elif code == 407:
            record("E3", False, f"CONNECT {target} denied by the proxy (407)")
        else:
            record("E3", True, f"CONNECT {target} -> {code}: not denied (upstream unreachable)", info=True)
    else:
        record("E3", False, "no pinned host entry on port 443")
    # E4: a name outside the allowlist is refused (enforce) / reported (observe).
    code = proxy_connect(proxy_ip, proxy_port, "selftest.legatto.invalid:443")
    if enforce:
        record("E4", code == 407, f"CONNECT selftest.legatto.invalid -> {code} (want 407)")
    else:
        record("E4", code != 407 and code is not None, f"observe: CONNECT -> {code} (reported, not denied)")
    # E5 / E6: a user outside the client list reaches neither the proxy nor the internet.
    nobody = uid_of("nobody")
    if nobody is None:
        record("E5", False, "user nobody missing")
        record("E6", False, "user nobody missing")
    elif enforce:
        reach_proxy = connect_as(nobody, proxy_ip, proxy_port)
        record("E5", not reach_proxy, f"nobody -> {proxy_ip}:{proxy_port} connected={reach_proxy} (want False)")
        reach_net = connect_as(nobody, "1.1.1.1", 443)
        record("E6", not reach_net, f"nobody -> 1.1.1.1:443 connected={reach_net} (want False)")
    else:
        record("E5", True, "observe mode: proxy port is logged, not blocked", info=True)
        record("E6", True, "observe mode: direct egress is logged, not blocked", info=True)
    # E7: DNS black hole stays unassigned.
    record("E7", *dns_blackhole_check(cfg))
    # E8: resolver cut for Caddy and the console.
    record("E8", *nodns_check(cfg))
    # E9 / E10: container proxies and internal networks.
    if docker_available():
        record("E9", *container_proxy_check(cfg, applied))
        record("E10", *internal_networks_check(cfg))
    else:
        record("E9", False, "docker not available")
        record("E10", False, "docker not available")
    ok = all(c["ok"] for c in checks.values())
    return {"ok": ok, "mode": cfg.mode, "release": applied.get("release"), "ts": utc_now(),
            "checks": checks}, (EXIT_OK if ok else EXIT_SELFTEST_FAILED)


def dns_blackhole_check(cfg: Config) -> tuple[bool, str]:
    ip = cfg.dns_blackhole
    res = subprocess.run(["ip", "-j", "addr"], capture_output=True, text=True, check=False)
    assigned = ip in res.stdout if res.returncode == 0 else False
    daemon_ok = False
    with contextlib.suppress(OSError, ValueError):
        daemon = json.loads(Path(cfg.docker["daemon_json"]).read_text(encoding="utf-8"))
        daemon_ok = daemon.get("dns") == [ip]
    in_net = False
    if docker_available():
        net = subprocess.run(["docker", "network", "inspect", cfg.docker["host_network"]],
                             capture_output=True, text=True, check=False)
        in_net = f'"{ip}/' in net.stdout
    ok = daemon_ok and not assigned and not in_net
    return ok, f"daemon dns=[{ip}]: {daemon_ok}; assigned on host: {assigned}; used by a container: {in_net}"


def nodns_check(cfg: Config) -> tuple[bool, str]:
    msgs, ok = [], True
    for unit in cfg.nodns_units:
        if not unit_loaded(unit):
            msgs.append(f"{unit}: not installed")
            continue
        res = subprocess.run(["systemctl", "show", "-p", "IPAddressDeny", "--value", unit],
                             capture_output=True, text=True, check=False)
        deny = res.stdout
        good = "127.0.0.53" in deny or "::/0" in deny or "0.0.0.0/0" in deny
        ok &= good
        msgs.append(f"{unit}: resolver denied={good}")
    return ok, "; ".join(msgs)


def container_proxy_check(cfg: Config, applied: dict) -> tuple[bool, str]:
    msgs, ok = [], True
    for role in applied.get("roles_active", []):
        if role == "host":
            continue
        ids = proxy_containers(cfg, role, all_states=False)
        acl = cfg.p("proxy_dir") / role / "acl.yaml"
        if not ids:
            ok = False
            msgs.append(f"{role}: proxy not running")
            continue
        res = subprocess.run(["docker", "inspect", "--format", "{{.State.StartedAt}}", ids[0]],
                             capture_output=True, text=True, check=False)
        started = res.stdout.strip()
        try:
            started_ts = dt.datetime.fromisoformat(started[:26].rstrip("Z") + "+00:00").timestamp()
        except ValueError:
            started_ts = 0.0
        fresh = started_ts + 1 >= acl.stat().st_mtime if acl.exists() else False
        ok &= fresh
        msgs.append(f"{role}: running, ACL loaded={fresh}")
    return ok, "; ".join(msgs) or "no active container role"


def internal_networks_check(cfg: Config) -> tuple[bool, str]:
    msgs, ok = [], True
    for name in cfg.docker["internal_networks"]:
        res = subprocess.run(["docker", "network", "inspect", "--format", "{{.Internal}}", name],
                             capture_output=True, text=True, check=False)
        internal = res.stdout.strip() == "true"
        ok &= internal
        msgs.append(f"{name}: internal={internal}")
    return ok, "; ".join(msgs)


# --------------------------------------------------------------------------- validate-data


def validate_data(args: argparse.Namespace) -> dict:
    if args.egress_json:
        data = read_json(Path(args.egress_json), "egress")
        egress = data.get("egress", data) if isinstance(data, dict) else data
    else:
        base = read_json(Path(args.base), "base")
        feats = read_json(Path(args.features), "features")
        if not isinstance(base, dict) or not isinstance(feats, dict):
            raise invalid("base and features must be objects")
        if base.get("version") != 1 or feats.get("version") != 1:
            raise invalid("base.version and features.version must be 1")
        egress = {"version": 1, "roles": base.get("roles"), "features": feats.get("features")}
    v = validate_egress(None, egress)
    return {"ok": True, "roles": {r: len(e) for r, e in v["roles"].items()},
            "features": sorted(v["features"])}


# --------------------------------------------------------------------------- CLI


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="legatto-egress", description=__doc__.split("\n", 1)[0])
    p.add_argument("--config", default=os.environ.get(CONFIG_ENV, DEFAULT_CONFIG),
                   help=f"config.json written by the Ansible role (default {DEFAULT_CONFIG})")
    p.add_argument("--version", action="version", version=GENERATOR)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("render", help="render proxy configs, ACLs and egress.nft into a directory")
    s.add_argument("--release-dir", required=True, help="release directory with manifest.json, or 'none'")
    s.add_argument("--out", required=True)
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("check", help="validate a rendered directory (ACL rules, consistency, nft -c)")
    s.add_argument("--dir", required=True)
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("diff", help="allowlist difference between two releases")
    s.add_argument("--from", dest="from_dir", required=True, help="old release dir ('none' or missing = empty)")
    s.add_argument("--to", dest="to_dir", required=True)
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("apply", help="render + check + atomic switch + proxy restart")
    s.add_argument("--release-dir", help="release directory (default: the current release)")
    s.add_argument("--actor", help="audit actor JSON")
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("status", help="egress.json (with --write: recount denials and write it)")
    s.add_argument("--write", action="store_true")
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("selftest", help="checks E1-E10 (release health check egress:selftest)")
    s.add_argument("--json", action="store_true")

    s = sub.add_parser("validate-data", help="validate allowlist data before it enters a release")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--egress-json", help="manifest.json or its egress object (JSON)")
    g.add_argument("--base", help="base allowlist as JSON (yq -o=json bundle/egress/base.yml)")
    s.add_argument("--features", help="features allowlist as JSON (with --base)")
    s.add_argument("--json", action="store_true")
    return p


def emit(args: argparse.Namespace, result: dict, human: str) -> None:
    if getattr(args, "json", False):
        print(json.dumps(result, sort_keys=True, ensure_ascii=False))
    else:
        print(human, file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return EXIT_OK if exc.code == 0 else EXIT_USAGE
    try:
        if args.cmd == "validate-data":
            if args.base and not args.features:
                raise EgressError("--base requires --features", EXIT_USAGE)
            result = validate_data(args)
            emit(args, result, "allowlist data valid")
            return EXIT_OK
        if args.cmd in ("apply", "selftest") or (args.cmd == "status" and args.write):
            require_root()
        cfg = Config(Path(args.config))
        if args.cmd == "render":
            result = render(cfg, args.release_dir, Path(args.out))
            emit(args, result, f"rendered {len(result['files'])} files to {args.out}")
            return EXIT_OK
        if args.cmd == "check":
            result = check(cfg, Path(args.dir))
            emit(args, result, f"{args.dir}: OK")
            return EXIT_OK
        if args.cmd == "diff":
            result, code = diff(cfg, args.from_dir, args.to_dir)
            print(json.dumps(result, sort_keys=True, ensure_ascii=False))
            if code == EXIT_PINNED_REMOVED:
                log("release removes pinned entries: " +
                    ", ".join(f"{e['role']}:{e['host']}:{e['port']}" for e in result["pinned_removed"]))
            elif code == EXIT_WIDENING:
                log(f"release widens egress ({len(result['widening_entries'])} entries); admin approval needed")
            return code
        if args.cmd == "apply":
            release_dir = args.release_dir or str(cfg.p("current"))
            actor = parse_actor(args.actor)
            result = apply(cfg, release_dir, actor)
            emit(args, result, f"applied release {result['release']} in mode {result['mode']}; "
                               f"active roles: {', '.join(result['roles_active'])}")
            for note in result["notes"]:
                log(note)
            return EXIT_OK
        if args.cmd == "status":
            result = status(cfg, args.write)
            emit(args, result, f"mode {result['mode']}, denied_5m {result['denied_5m']}, ok {result['ok']}")
            return EXIT_OK
        if args.cmd == "selftest":
            result, code = selftest(cfg)
            human = "\n".join(f"{k}: {'PASS' if v['ok'] else 'FAIL'}{' (info)' if v.get('info') else ''} "
                              f"{v['msg']}" for k, v in result["checks"].items())
            emit(args, result, human)
            return code
        raise EgressError(f"unknown command {args.cmd}", EXIT_USAGE)
    except EgressError as exc:
        log(f"error: {exc}")
        return exc.code
    except Exception as exc:  # noqa: BLE001 - last-resort exit code 1 with a message
        log(f"unexpected error: {exc.__class__.__name__}: {exc}")
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
