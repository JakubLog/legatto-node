#!/usr/bin/python3
"""legatto-studio — Supabase Studio on demand (lane platform, P9).

Studio is an SQL console with postgres rights (bypasses RLS and the app audit), so it
runs only inside a time window opened by the office admin (console request
studio.enable) or by the vendor in break-glass. Studio and postgres-meta are the
compose services of profile "admin"; Caddy serves them on studio.app.<domain>
(tailnet IPv6, office devices and vendor only) behind Envoy basic auth.

Subcommands (docs/CONTRACT.md §4.6):
  enable --hours N --actor JSON   start meta+studio, window of N hours (1-8); audit studio.enable
  disable --actor JSON            stop and remove meta+studio; audit studio.disable
  status [--json]                 {"v":1,"enabled","running","expires_at","url","actor"}
  reconcile                       legatto-studio-reconcile.timer: close an expired window
                                  (audit studio.expire) and stop Studio running without one

Exit codes: 0 ok, 1 unexpected error, 2 bad arguments, 3 lock busy, 4 precondition,
43 Studio did not start.
"""

import argparse
import datetime
import fcntl
import json
import os
import subprocess
import sys
import tempfile
import time

# contract: legatto_paths.studio_state
STATE_FILE = "/var/lib/legatto/studio.json"
# contract: legatto_paths.office_env
OFFICE_ENV = "/etc/legatto/office.env"
# contract: legatto_paths.sbin
SBIN = "/opt/legatto/sbin"
# contract: legatto_cli.stack
STACK = SBIN + "/legatto-stack"
# contract: legatto_cli.audit
AUDIT = SBIN + "/legatto-audit"
# contract: legatto_paths.run
RUN_DIR = "/run/legatto"
LOCK_FILE = RUN_DIR + "/studio.lock"
# contract: legatto_compose_project
PROJECT = "legatto"
SERVICES = ("meta", "studio")
HOURS_MIN, HOURS_MAX = 1, 8  # contract: legatto_breakglass.hours_min/max (same window bounds)
ACTOR_KINDS = ("office-admin", "vendor", "system", "bootstrap")
SYSTEM_ACTOR = {"kind": "system", "id": "legatto-studio"}


class Fail(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def log(msg):
    print("legatto-studio: " + msg, file=sys.stderr, flush=True)


def utc(dt=None):
    dt = dt or datetime.datetime.now(datetime.timezone.utc)
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def require_root():
    if os.geteuid() != 0:
        raise Fail(4, "must run as root")


def take_lock():
    os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
    fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.monotonic() + 10
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() > deadline:
                os.close(fd)
                raise Fail(3, "another legatto-studio run holds " + LOCK_FILE)
            time.sleep(0.2)


def parse_actor(text):
    try:
        actor = json.loads(text)
    except json.JSONDecodeError:
        raise Fail(2, "--actor is not JSON")
    if not isinstance(actor, dict) or actor.get("kind") not in ACTOR_KINDS or not isinstance(actor.get("id"), str):
        raise Fail(2, "--actor must be {\"kind\": one of %s, \"id\": str}" % "|".join(ACTOR_KINDS))
    return actor


def read_state():
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as fh:
            state = json.load(fh)
        if isinstance(state, dict):
            return state
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return {"v": 1, "enabled": False, "expires_at": None, "actor": None, "started_at": None}


def write_state(state):
    directory = os.path.dirname(STATE_FILE)
    fd, tmp = tempfile.mkstemp(prefix=".studio-", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, (json.dumps(state, sort_keys=True) + "\n").encode("utf-8"))
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(tmp, STATE_FILE)
    finally:
        if fd >= 0:
            os.close(fd)
        if os.path.exists(tmp):
            os.unlink(tmp)


def running_services():
    proc = subprocess.run(["docker", "ps", "--filter", "label=com.docker.compose.project=" + PROJECT,
                           "--format", '{{.Label "com.docker.compose.service"}}'],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise Fail(1, "docker ps failed")
    return sorted(set(proc.stdout.split()) & set(SERVICES))


def audit(event, actor, params):
    proc = subprocess.run([AUDIT, "append", "--cat", "studio", "--event", event,
                           "--actor", json.dumps(actor, sort_keys=True),
                           "--params", json.dumps(params, sort_keys=True)],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise Fail(1, "legatto-audit append %s failed (%d)" % (event, proc.returncode))


def stack(*args):
    return subprocess.run([STACK] + list(args)).returncode


def studio_url():
    host = None
    try:
        with open(OFFICE_ENV, "r", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("LEGATTO_HOST_STUDIO="):
                    host = line.rstrip("\n").split("=", 1)[1]
    except FileNotFoundError:
        pass
    return "https://" + host if host else None


def stop_studio():
    if stack("stop", *SERVICES) != 0:
        raise Fail(1, "legatto-stack stop meta studio failed")


def cmd_enable(args):
    require_root()
    if not HOURS_MIN <= args.hours <= HOURS_MAX:
        raise Fail(2, "--hours must be %d..%d" % (HOURS_MIN, HOURS_MAX))
    actor = parse_actor(args.actor)
    fd = take_lock()
    try:
        now = datetime.datetime.now(datetime.timezone.utc)
        expires = now + datetime.timedelta(hours=args.hours)
        state = {"v": 1, "enabled": True, "started_at": utc(now), "expires_at": utc(expires), "actor": actor}
        # State first: legatto-stack starts profile admin only while the window is open.
        write_state(state)
        if stack("start", *SERVICES) != 0:
            write_state({"v": 1, "enabled": False, "started_at": None, "expires_at": None, "actor": actor})
            stop_studio()
            raise Fail(43, "Studio did not become healthy; window closed")
        audit("studio.enable", actor, {"hours": args.hours, "expires_at": state["expires_at"]})
        log("Studio enabled until %s" % state["expires_at"])
        return 0
    finally:
        os.close(fd)


def close_window(actor, event, reason):
    previous = read_state()
    stop_studio()
    write_state({"v": 1, "enabled": False, "started_at": None, "expires_at": None, "actor": actor})
    audit(event, actor, {"reason": reason, "window_expires_at": previous.get("expires_at")})


def cmd_disable(args):
    require_root()
    actor = parse_actor(args.actor)
    fd = take_lock()
    try:
        close_window(actor, "studio.disable", "requested")
        log("Studio disabled")
        return 0
    finally:
        os.close(fd)


def cmd_reconcile(_args):
    require_root()
    fd = take_lock()
    try:
        state = read_state()
        running = running_services()
        if state.get("enabled") and (state.get("expires_at") or "") <= utc():
            close_window(SYSTEM_ACTOR, "studio.expire", "window expired")
            log("Studio window expired; stopped")
        elif not state.get("enabled") and running:
            close_window(SYSTEM_ACTOR, "studio.disable", "running without a window: " + ",".join(running))
            log("Studio was running without a window; stopped")
        return 0
    finally:
        os.close(fd)


def cmd_status(args):
    state = read_state()
    try:
        running = bool(running_services())
    except (Fail, OSError):
        running = False
    enabled = bool(state.get("enabled")) and (state.get("expires_at") or "") > utc()
    doc = {"v": 1, "enabled": enabled, "running": running,
           "expires_at": state.get("expires_at") if enabled else None,
           "url": studio_url(), "actor": state.get("actor") if enabled else None}
    if args.json:
        print(json.dumps(doc, sort_keys=True))
    else:
        print("Studio: %s%s" % ("enabled until " + doc["expires_at"] if enabled else "disabled",
                                " (running)" if running else ""))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="legatto-studio", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("enable")
    p.add_argument("--hours", type=int, required=True)
    p.add_argument("--actor", required=True)
    p = sub.add_parser("disable")
    p.add_argument("--actor", required=True)
    p = sub.add_parser("status")
    p.add_argument("--json", action="store_true")
    sub.add_parser("reconcile")
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return 2 if exc.code else 0
    try:
        return {"enable": cmd_enable, "disable": cmd_disable, "status": cmd_status,
                "reconcile": cmd_reconcile}[args.cmd](args)
    except Fail as exc:
        log(str(exc))
        return exc.code
    except OSError as exc:
        log("error: %s" % exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
