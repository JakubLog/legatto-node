#!/usr/bin/python3
r"""legatto-secrets — server-side secrets of the Legatto platform (lane platform).

Subcommands (docs/CONTRACT.md §4.6):
  init                 create missing secrets in /etc/legatto/secrets (never overwrites)
  check [--json]       presence, permissions and consistency of the secrets (never values)
  render [--templates DIR] [--out DIR] [--no-keys] [--check] [--json]
                       render env templates (env/*.env.tmpl from the release) into
                       /run/legatto/env/<name>.env (0400 root) and place the PII field key
                       in /run/legatto/keys (tmpfs); --check only validates the templates

Template syntax (one `KEY=value` per line, `#` comments, blank lines ignored):
  ${LEGATTO_*}           key of /etc/legatto/office.env (contract legatto_office_env)
  ${secret:<name>}       file /etc/legatto/secrets/<name> (names: SECRETS below)
  ${feature:<name>}      on|off from /var/lib/legatto/office/features.json
  ${feature_bool:<name>} true|false, same source
  ${features:ics_hosts}  comma-separated host list, same source
The rendered value is written in the dotenv dialect of docker compose: plain when it
contains only safe characters, otherwise double-quoted with \\ \" \$ escaped.

Exit codes: 0 ok, 1 unexpected error, 2 bad arguments, 3 lock busy, 4 precondition
(not root, missing office.env/secrets), 31 check found a problem, 42 invalid template.
Nothing secret is ever printed.
"""

import argparse
import base64
import fcntl
import hashlib
import hmac
import json
import os
import re
import secrets
import stat
import sys
import tempfile
import time

# contract: legatto_paths.secrets
SECRETS_DIR = "/etc/legatto/secrets"
# contract: legatto_paths.office_env
OFFICE_ENV = "/etc/legatto/office.env"
# contract: legatto_paths.features
FEATURES_FILE = "/var/lib/legatto/office/features.json"
# contract: legatto_paths.env_templates_current
TEMPLATES_DIR = "/opt/legatto/current/env"
# contract: legatto_paths.run_env
RUN_ENV_DIR = "/run/legatto/env"
# contract: legatto_paths.pii_key
PII_KEY = "/run/legatto/keys/pii_field_key"
# contract: legatto_paths.pii_key_src
PII_KEY_SRC = "/etc/legatto/secrets/pii_field_key"
# contract: legatto_paths.run
RUN_DIR = "/run/legatto"
# contract: legatto_container_uid
CONTAINER_UID = 65532
# contract: legatto_feature_names
FEATURE_NAMES = ("ai", "mcp", "email", "getresponse", "push", "ics", "hibp")
# contract: legatto_feature_defaults
FEATURE_DEFAULTS = {"ai": False, "mcp": False, "email": False, "getresponse": False,
                    "push": False, "ics": False, "hibp": True}
# contract: legatto_office_env (keys)
OFFICE_KEYS = ("LEGATTO_CONTRACT_VERSION", "LEGATTO_SLUG", "LEGATTO_ENV", "LEGATTO_OFFICE_TITLE",
               "LEGATTO_OFFICE_DOMAIN", "LEGATTO_HOST_SITE", "LEGATTO_HOST_VPN", "LEGATTO_HOST_CRM",
               "LEGATTO_HOST_ADMIN", "LEGATTO_HOST_STUDIO", "LEGATTO_TS_IP4", "LEGATTO_TS_IP6",
               "LEGATTO_PUBLIC_IPV4", "LEGATTO_TZ")
LOCK_FILE = RUN_DIR + "/secrets.lock"

ALNUM = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
JWT_LIFETIME_SECONDS = 10 * 365 * 24 * 3600


def _alnum(n):
    return lambda: "".join(secrets.choice(ALNUM) for _ in range(n))


def _hex(nbytes):
    return lambda: secrets.token_hex(nbytes)


def _hook_secret():
    # Standard Webhooks secret as GoTrue expects it: v1,whsec_<base64 of 32 bytes>
    return "v1,whsec_" + base64.b64encode(secrets.token_bytes(32)).decode("ascii")


# name -> (generator, or None when derived from jwt_secret; format regex)
SECRETS = {
    "postgres_password": (_alnum(40), r"[A-Za-z0-9]{40}"),
    "jwt_secret": (_alnum(64), r"[A-Za-z0-9]{64}"),
    "anon_key": (None, r"[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"),
    "service_role_key": (None, r"[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+"),
    "dashboard_password": (_alnum(40), r"[A-Za-z0-9]{40}"),
    "secret_key_base": (_alnum(64), r"[A-Za-z0-9]{64}"),
    # Realtime uses it as an AES-128 key: exactly 16 characters.
    "realtime_db_enc_key": (_alnum(16), r"[A-Za-z0-9]{16}"),
    "pg_meta_crypto_key": (_alnum(48), r"[A-Za-z0-9]{48}"),
    "s3_protocol_access_key_id": (_hex(16), r"[0-9a-f]{32}"),
    "s3_protocol_access_key_secret": (_hex(32), r"[0-9a-f]{64}"),
    "cron_secret": (_alnum(48), r"[A-Za-z0-9]{48}"),
    "auth_hook_secret": (_hook_secret, r"v1,whsec_[A-Za-z0-9+/]{43}="),
    # Same format the supabase/postgres image generates itself (pgsodium_getkey).
    "pgsodium_root.key": (_hex(32), r"[0-9a-f]{64}"),
    "pii_field_key": (_hex(32), r"[0-9a-f]{64}"),
}
DERIVED_JWT_ROLES = {"anon_key": "anon", "service_role_key": "service_role"}

PLACEHOLDER_RE = re.compile(r"\$\{([^}]*)\}")
KEY_RE = re.compile(r"^[A-Z_][A-Z0-9_]*$")
SAFE_VALUE_RE = re.compile(r"^[A-Za-z0-9_./:,@+=%-]*$")
TEMPLATE_NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,40}\.env\.tmpl$")


class Fail(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def log(msg):
    print("legatto-secrets: " + msg, file=sys.stderr)


def require_root():
    if os.geteuid() != 0:
        raise Fail(4, "must run as root")


def lock():
    os.makedirs(RUN_DIR, exist_ok=True)
    fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.monotonic() + 10
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() > deadline:
                raise Fail(3, "another legatto-secrets run holds " + LOCK_FILE)
            time.sleep(0.2)


def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")


def make_jwt(secret, role, now):
    header = b64url(json.dumps({"alg": "HS256", "typ": "JWT"}, separators=(",", ":")).encode())
    payload = b64url(json.dumps({"role": role, "iss": "supabase", "iat": now,
                                 "exp": now + JWT_LIFETIME_SECONDS}, separators=(",", ":")).encode())
    signing_input = (header + "." + payload).encode("ascii")
    sig = hmac.new(secret.encode("ascii"), signing_input, hashlib.sha256).digest()
    return header + "." + payload + "." + b64url(sig)


def jwt_matches(token, secret, role):
    try:
        header, payload, sig = token.split(".")
        expected = b64url(hmac.new(secret.encode("ascii"), (header + "." + payload).encode("ascii"),
                                   hashlib.sha256).digest())
        if not hmac.compare_digest(expected, sig):
            return False
        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
        return claims.get("role") == role and claims.get("exp", 0) > time.time()
    except (ValueError, json.JSONDecodeError):
        return False


def atomic_write(path, data, mode=0o400, uid=0, gid=0, exclusive=False):
    """Write bytes atomically; with exclusive=True never replace an existing file."""
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=directory)
    try:
        os.fchmod(fd, mode)
        os.fchown(fd, uid, gid)
        os.write(fd, data)
        os.fsync(fd)
        os.close(fd)
        fd = -1
        if exclusive:
            os.link(tmp, path)  # FileExistsError if it appeared meanwhile
            os.unlink(tmp)
        else:
            os.replace(tmp, path)
        dfd = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    finally:
        if fd >= 0:
            os.close(fd)
        if os.path.exists(tmp):
            os.unlink(tmp)


def read_secret(name):
    with open(os.path.join(SECRETS_DIR, name), "r", encoding="ascii") as fh:
        return fh.read()


def ensure_secrets_dir():
    if not os.path.isdir(SECRETS_DIR):
        os.makedirs(SECRETS_DIR, mode=0o700)
    st = os.stat(SECRETS_DIR)
    if st.st_uid != 0 or stat.S_IMODE(st.st_mode) & 0o077:
        raise Fail(4, SECRETS_DIR + " must be 0700 root")


# --- init ---------------------------------------------------------------------------------

def cmd_init(args):
    require_root()
    ensure_secrets_dir()
    fd = lock()
    try:
        created = []
        present = {n: os.path.exists(os.path.join(SECRETS_DIR, n)) for n in SECRETS}
        if not present["jwt_secret"] and (present["anon_key"] or present["service_role_key"]):
            raise Fail(4, "anon_key/service_role_key exist without jwt_secret; refusing to mint a new secret")
        for name, (generator, _) in SECRETS.items():
            if present[name] or generator is None:
                continue
            atomic_write(os.path.join(SECRETS_DIR, name), generator().encode("ascii"), exclusive=True)
            created.append(name)
        now = int(time.time())
        jwt_secret = read_secret("jwt_secret")
        for name, role in DERIVED_JWT_ROLES.items():
            if not os.path.exists(os.path.join(SECRETS_DIR, name)):
                atomic_write(os.path.join(SECRETS_DIR, name), make_jwt(jwt_secret, role, now).encode("ascii"),
                             exclusive=True)
                created.append(name)
        result = {"v": 1, "ok": True, "created": created}
        if args.json:
            print(json.dumps(result, sort_keys=True))
        log("created %d secret(s): %s" % (len(created), ", ".join(created) or "none"))
        return 0
    finally:
        os.close(fd)


# --- check --------------------------------------------------------------------------------

def check_secrets():
    errors = []
    report = {}
    try:
        st = os.stat(SECRETS_DIR)
        dir_info = {"mode": "%04o" % stat.S_IMODE(st.st_mode), "owner": st.st_uid}
        if st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o700:
            errors.append("secrets_dir_permissions")
    except FileNotFoundError:
        return {"dir": None, "secrets": {}}, ["secrets_dir_missing"]
    for name, (_, pattern) in SECRETS.items():
        path = os.path.join(SECRETS_DIR, name)
        entry = {"present": False, "ok": False}
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            errors.append("missing:" + name)
            report[name] = entry
            continue
        entry["present"] = True
        entry["mode"] = "%04o" % stat.S_IMODE(st.st_mode)
        entry["owner"] = st.st_uid
        ok = stat.S_ISREG(st.st_mode) and st.st_uid == 0 and stat.S_IMODE(st.st_mode) == 0o400
        if not ok:
            errors.append("permissions:" + name)
        try:
            value = read_secret(name)
            if not re.fullmatch(pattern, value):
                ok = False
                errors.append("format:" + name)
        except (OSError, UnicodeDecodeError):
            ok = False
            errors.append("unreadable:" + name)
        entry["ok"] = ok
        report[name] = entry
    if all(report.get(n, {}).get("present") for n in ("jwt_secret", "anon_key", "service_role_key")):
        jwt_secret = read_secret("jwt_secret")
        for name, role in DERIVED_JWT_ROLES.items():
            if not jwt_matches(read_secret(name), jwt_secret, role):
                report[name]["ok"] = False
                errors.append("jwt_mismatch:" + name)
    return {"dir": dir_info, "secrets": report}, errors


def cmd_check(args):
    require_root()
    report, errors = check_secrets()
    result = {"v": 1, "ok": not errors, "errors": errors}
    result.update(report)
    if args.json:
        print(json.dumps(result, sort_keys=True))
    for err in errors:
        log("problem: " + err)
    return 0 if not errors else 31


# --- render -------------------------------------------------------------------------------

def parse_env_file(path):
    """KEY=value per line, no quoting, no expansion (contract §4.1)."""
    values = {}
    with open(path, "r", encoding="utf-8") as fh:
        for lineno, raw in enumerate(fh, 1):
            line = raw.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            key, sep, value = line.partition("=")
            if not sep or not KEY_RE.match(key):
                raise Fail(4, "%s:%d: not KEY=value" % (path, lineno))
            values[key] = value
    return values


def load_features():
    features = dict(FEATURE_DEFAULTS)
    ics_hosts = []
    try:
        with open(FEATURES_FILE, "r", encoding="utf-8") as fh:
            doc = json.load(fh)
    except FileNotFoundError:
        log("no %s; using contract defaults" % FEATURES_FILE)
        return features, ics_hosts
    except json.JSONDecodeError as exc:
        raise Fail(4, "%s is not JSON: %s" % (FEATURES_FILE, exc))
    flags = doc.get("features", {})
    if not isinstance(flags, dict):
        raise Fail(4, FEATURES_FILE + ": 'features' is not an object")
    for name in FEATURE_NAMES:
        if name in flags:
            if not isinstance(flags[name], bool):
                raise Fail(4, "%s: feature %s is not a boolean" % (FEATURES_FILE, name))
            features[name] = flags[name]
    hosts = doc.get("ics_hosts", [])
    host_re = re.compile(r"^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
    if not isinstance(hosts, list) or not all(isinstance(h, str) and host_re.match(h) for h in hosts):
        raise Fail(4, FEATURES_FILE + ": 'ics_hosts' must be a list of host names")
    return features, sorted(set(hosts))


def classify(expr):
    """Return (kind, name) of a placeholder expression or raise ValueError."""
    if expr in OFFICE_KEYS:
        return "office", expr
    kind, sep, name = expr.partition(":")
    if sep:
        if kind == "secret" and name in SECRETS:
            return kind, name
        if kind in ("feature", "feature_bool") and name in FEATURE_NAMES:
            return kind, name
        if kind == "features" and name == "ics_hosts":
            return kind, name
    raise ValueError(expr)


def parse_template(path):
    """Return [(lineno, key, value_template)] or raise Fail(42) listing every problem."""
    entries, errors, seen = [], [], set()
    with open(path, "r", encoding="utf-8") as fh:
        for lineno, raw in enumerate(fh, 1):
            line = raw.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            key, sep, value = line.partition("=")
            where = "%s:%d" % (os.path.basename(path), lineno)
            if not sep or not KEY_RE.match(key):
                errors.append(where + ": expected KEY=value")
                continue
            if key in seen:
                errors.append(where + ": duplicate key " + key)
            seen.add(key)
            if "\r" in value or "\x00" in value:
                errors.append(where + ": control character in value")
            for expr in PLACEHOLDER_RE.findall(value):
                try:
                    classify(expr)
                except ValueError:
                    errors.append(where + ": unknown placeholder ${%s}" % expr)
            if "${" in PLACEHOLDER_RE.sub("", value):
                errors.append(where + ": unterminated placeholder")
            entries.append((lineno, key, value))
    return entries, errors


def list_templates(directory):
    try:
        names = sorted(os.listdir(directory))
    except FileNotFoundError:
        raise Fail(4, "templates directory %s does not exist" % directory)
    templates, errors = [], []
    for name in names:
        if name.startswith("."):
            continue
        if not name.endswith(".env.tmpl"):
            errors.append(name + ": not an *.env.tmpl file")
        elif not TEMPLATE_NAME_RE.match(name):
            errors.append(name + ": invalid template name")
        elif not os.path.isfile(os.path.join(directory, name)) or os.path.islink(os.path.join(directory, name)):
            errors.append(name + ": not a regular file")
        else:
            templates.append(name)
    if not templates and not errors:
        errors.append("no *.env.tmpl templates in " + directory)
    return templates, errors


def dotenv_quote(value):
    if SAFE_VALUE_RE.match(value):
        return value
    if "\n" in value:
        raise Fail(42, "rendered value contains a newline")
    escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$")
    return '"' + escaped + '"'


def render_value(template, office, features, ics_hosts, secret_cache):
    def substitute(match):
        kind, name = classify(match.group(1))
        if kind == "office":
            if name not in office:
                raise Fail(4, "%s lacks %s" % (OFFICE_ENV, name))
            return office[name]
        if kind == "secret":
            if name not in secret_cache:
                path = os.path.join(SECRETS_DIR, name)
                if not os.path.exists(path):
                    raise Fail(4, "secret %s missing (run legatto-secrets init)" % name)
                secret_cache[name] = read_secret(name)
            return secret_cache[name]
        if kind == "feature":
            return "on" if features[name] else "off"
        if kind == "feature_bool":
            return "true" if features[name] else "false"
        return ",".join(ics_hosts)

    return PLACEHOLDER_RE.sub(substitute, template)


def cmd_render(args):
    templates, errors = list_templates(args.templates)
    parsed = {}
    for name in templates:
        entries, errs = parse_template(os.path.join(args.templates, name))
        parsed[name] = entries
        errors.extend(errs)
    if args.check or errors:
        result = {"v": 1, "ok": not errors, "templates": templates, "errors": errors}
        if args.json:
            print(json.dumps(result, sort_keys=True))
        for err in errors:
            log("template error: " + err)
        return 42 if errors else 0

    require_root()
    fd = lock()
    try:
        try:
            office = parse_env_file(OFFICE_ENV)
        except FileNotFoundError:
            raise Fail(4, OFFICE_ENV + " missing")
        features, ics_hosts = load_features()
        os.makedirs(args.out, mode=0o700, exist_ok=True)
        os.chmod(args.out, 0o700)
        cache = {}
        written = []
        for name, entries in parsed.items():
            lines = ["# Rendered by legatto-secrets from %s. Do not edit." % name]
            for _, key, value in entries:
                lines.append(key + "=" + dotenv_quote(render_value(value, office, features, ics_hosts, cache)))
            out_name = name[: -len(".tmpl")]
            atomic_write(os.path.join(args.out, out_name), ("\n".join(lines) + "\n").encode("utf-8"))
            written.append(out_name)
        for stale in os.listdir(args.out):
            if stale.endswith(".env") and stale not in written:
                os.unlink(os.path.join(args.out, stale))
        if not args.no_keys:
            place_pii_key()
        if args.json:
            print(json.dumps({"v": 1, "ok": True, "written": written, "keys": not args.no_keys}, sort_keys=True))
        log("rendered %s into %s" % (", ".join(written), args.out))
        return 0
    finally:
        os.close(fd)


def place_pii_key():
    """D11 variant A: copy the PII field key from disk to tmpfs, readable by the app uid only."""
    try:
        data = open(PII_KEY_SRC, "rb").read()
    except FileNotFoundError:
        raise Fail(4, "%s missing (run legatto-secrets init)" % PII_KEY_SRC)
    keys_dir = os.path.dirname(PII_KEY)
    os.makedirs(keys_dir, mode=0o711, exist_ok=True)
    os.chmod(keys_dir, 0o711)
    if os.path.isdir(PII_KEY) and not os.path.islink(PII_KEY):
        # Docker creates a directory for a missing bind source; reclaim the path.
        os.rmdir(PII_KEY)
    atomic_write(PII_KEY, data, mode=0o400, uid=CONTAINER_UID, gid=CONTAINER_UID)


def main(argv=None):
    parser = argparse.ArgumentParser(prog="legatto-secrets", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_init = sub.add_parser("init", help="create missing secrets (never overwrites)")
    p_init.add_argument("--json", action="store_true")
    p_check = sub.add_parser("check", help="presence and permissions, no values")
    p_check.add_argument("--json", action="store_true")
    p_render = sub.add_parser("render", help="render env templates into /run/legatto/env")
    p_render.add_argument("--templates", default=TEMPLATES_DIR)
    p_render.add_argument("--out", default=RUN_ENV_DIR)
    p_render.add_argument("--no-keys", action="store_true", help="do not place the PII key in tmpfs")
    p_render.add_argument("--check", action="store_true", help="validate templates only")
    p_render.add_argument("--json", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return 2 if exc.code else 0
    try:
        return {"init": cmd_init, "check": cmd_check, "render": cmd_render}[args.cmd](args)
    except Fail as exc:
        log(str(exc))
        return exc.code
    except OSError as exc:
        log("error: %s" % exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
