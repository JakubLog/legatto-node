#!/usr/bin/python3
"""legatto-restore-test — prove that the newest local pg_dump restores.

    legatto-restore-test run [--dump NAME] [--report FILE] [--json] [--actor JSON]
    legatto-restore-test record --report FILE --mode hetzner [--json] --actor JSON
    legatto-restore-test status [--json]

`run` (root; monthly timer, on demand, and on a Hetzner backup clone through
scripts/restore-test.sh) restores the newest dump of /var/backups/legatto/pg
into a throw-away container of the very image the production database uses,
without any network (`--network none`), and compares, table by table, row
counts and order-independent row checksums with the values legatto-pgdump
recorded from the same snapshot as the dump. Only names, counts and booleans
leave the container; pg_restore messages are counted, never stored.

`record` stores the result of a Hetzner clone test (report produced on the
clone by `run --json`, wrapped by scripts/restore-test.sh) in
status/restore-test.json and the audit log of the production server.

Exit codes: 0 ok, 1 unexpected, 2 arguments, 3 lock busy, 4 precondition,
10 restore test failed (status written), 11 no usable dump, 12 invalid report.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone

ROOT = os.environ.get("LEGATTO_ROOT", "")  # test hook; empty on servers

PGDUMP_DIR = "/var/backups/legatto/pg"             # contract: legatto_paths.pgdump
STATUS_DIR = "/var/lib/legatto/status"             # contract: legatto_paths.status
OPS_CONF = "/etc/legatto/ops.json"                 # contract: legatto_paths.ops_conf
RUN_DIR = "/run/legatto"                           # contract: legatto_paths.run
STATUS_GROUP = "legatto-status"                    # contract: legatto_groups.status
DB_CONTAINER = "supabase-db"                       # contract: legatto_container_db
AUDIT_CLI = "/usr/local/sbin/legatto-audit"        # contract: legatto_cli.audit
DEFAULT_ACTOR = {"kind": "system", "id": "legatto-restore-test"}
DB_USER = "supabase_admin"
DIR_RE = re.compile(r"^[0-9]{8}T[0-9]{6}Z$")
TS_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")
IMAGE_RE = re.compile(r"^(sha256:[0-9a-f]{64}|[a-z0-9./_-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64})$")
CHECK_RE = re.compile(r"^[a-z][a-z0-9_]{1,40}$")
READY_TIMEOUT_SECONDS = 300
RESTORE_TIMEOUT_SECONDS = 4 * 3600
CHECKS = ("dump_integrity", "container_started", "globals_applied", "pg_restore_clean", "tables_present",
          "row_counts", "checksums")

# Identical to legatto-pgdump (tests/ops compares both copies).
CHECKSUM_SQL = r"""SET LOCAL TimeZone = 'UTC';
SET LOCAL DateStyle = 'ISO, YMD';
SET LOCAL IntervalStyle = 'postgres';
SET LOCAL extra_float_digits = 1;
SET LOCAL bytea_output = 'hex';
SELECT 'LGT|server_version_num|' || current_setting('server_version_num');
SELECT format('SELECT %L || count(*) || %L || coalesce(sum((%L || substr(md5(t::text), 1, 16))::bit(64)::bigint::numeric), 0) || %L FROM %I.%I t',
              'LGT|table|', '|', 'x', '|' || quote_ident(n.nspname) || '.' || quote_ident(c.relname), n.nspname, c.relname)
FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind = 'r' AND c.relpersistence = 'p'
  AND n.nspname <> 'information_schema' AND n.nspname !~ '^pg_'
  AND (NOT EXISTS (SELECT 1 FROM pg_depend d
                   WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')
       OR c.oid IN (SELECT unnest(extconfig) FROM pg_extension))
ORDER BY n.nspname, c.relname \gexec
"""
CHECK_SCRIPT = ("\\set ON_ERROR_STOP on\n\\o | cat 1>&2\nBEGIN ISOLATION LEVEL REPEATABLE READ, READ ONLY;\n"
                + CHECKSUM_SQL + "COMMIT;\n")


class Failure(Exception):
    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


def path(p: str) -> str:
    return ROOT + p


def log(message: str) -> None:
    print(f"legatto-restore-test: {message}", file=sys.stderr)


def utc_now() -> datetime:
    return datetime.now(timezone.utc).replace(microsecond=0)


def fmt_ts(dt: datetime) -> str:
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def read_json(p: str, limit: int = 4 * 1024 * 1024) -> dict | None:
    try:
        with open(p, "rb") as fh:
            raw = fh.read(limit + 1)
    except OSError:
        return None
    if len(raw) > limit:
        return None
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def write_status(doc: dict) -> None:
    directory = path(STATUS_DIR)
    data = (json.dumps(doc, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
    fd, tmp = tempfile.mkstemp(prefix=".restore-test.", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fchmod(fh.fileno(), 0o640)
            if not ROOT:
                import grp
                os.fchown(fh.fileno(), 0, grp.getgrnam(STATUS_GROUP).gr_gid)
            os.fsync(fh.fileno())
        os.rename(tmp, os.path.join(directory, "restore-test.json"))
        dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def audit(actor: dict, params: dict) -> int | None:
    cmd = [path(AUDIT_CLI), "append", "--cat", "backup", "--event", "backup.restore_test",
           "--actor", json.dumps(actor, separators=(",", ":")),
           "--params", json.dumps(params, sort_keys=True, separators=(",", ":"))]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=60, check=False)
    except (OSError, subprocess.TimeoutExpired):
        log("audit: legatto-audit not runnable")
        return None
    if proc.returncode != 0:
        log(f"audit: legatto-audit exit {proc.returncode}")
        return None
    try:
        return int(json.loads(proc.stdout.decode("utf-8"))["seq"])
    except (ValueError, KeyError, TypeError, UnicodeDecodeError):
        return None


def parse_actor(raw: str | None, required: bool) -> dict:
    if raw is None:
        if required:
            raise Failure(2, "--actor is required")
        return dict(DEFAULT_ACTOR)
    try:
        actor = json.loads(raw)
    except ValueError:
        raise Failure(2, "--actor is not JSON") from None
    if (not isinstance(actor, dict) or actor.get("kind") not in ("office-admin", "vendor", "system", "bootstrap")
            or not isinstance(actor.get("id"), str) or not re.fullmatch(r"[a-z][a-z0-9.-]{1,40}", actor["id"])):
        raise Failure(2, "--actor must be {\"kind\":…,\"id\":…}")
    return {"kind": actor["kind"], "id": actor["id"]}


def lock():
    os.makedirs(path(RUN_DIR), mode=0o755, exist_ok=True)
    fh = open(path(f"{RUN_DIR}/restore-test.lock"), "a")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fh.close()
        raise Failure(3, "another legatto-restore-test is running")
    return fh


def sha256_file(p: str) -> str:
    digest = hashlib.sha256()
    with open(p, "rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def docker(args: list[str], *, stdin=None, timeout: int = 120, env: dict | None = None) -> subprocess.CompletedProcess:
    """docker CLI; stdout kept (small, technical), stderr discarded (may echo data)."""
    return subprocess.run(["docker", *args], stdin=stdin if stdin is not None else subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=timeout, check=False,
                          env=env)


def count_errors(args: list[str], stdin_path: str, timeout: int, pattern: bytes) -> tuple[int, int]:
    """Run docker exec with a file on stdin; return (exit code, number of error lines). Messages are dropped."""
    with open(stdin_path, "rb") as src, tempfile.TemporaryFile() as err:
        proc = subprocess.run(["docker", *args], stdin=src, stdout=subprocess.DEVNULL, stderr=err,
                              timeout=timeout, check=False)
        err.seek(0)
        errors = sum(1 for line in err if line.startswith(pattern))
    return proc.returncode, errors


def table_checksums(container: str) -> dict[str, tuple[int, str]] | None:
    proc = subprocess.run(["docker", "exec", "-i", container, "psql", "-h", "127.0.0.1", "-U", DB_USER,
                           "-d", "postgres", "-X", "-q", "-A", "-t", "-f", "-"],
                          input=CHECK_SCRIPT.encode(), stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                          timeout=RESTORE_TIMEOUT_SECONDS, check=False)
    if proc.returncode != 0:
        return None
    result: dict[str, tuple[int, str]] = {}
    for raw in proc.stderr.splitlines():
        if not raw.startswith(b"LGT|table|"):
            continue
        parts = raw.decode("utf-8", "replace").split("|", 4)
        if len(parts) == 5 and parts[2].isdigit() and re.fullmatch(r"-?[0-9]+", parts[3]):
            result[parts[4]] = (int(parts[2]), hashlib.sha256(f"{parts[2]}:{parts[3]}".encode()).hexdigest()[:16])
    return result


def db_image() -> str:
    proc = docker(["inspect", "--format", "{{.Image}}", DB_CONTAINER], timeout=30)
    image = proc.stdout.decode("ascii", "replace").strip()
    if proc.returncode == 0 and IMAGE_RE.match(image):
        return image
    conf = read_json(path(OPS_CONF)) or {}
    image = conf.get("db_image")
    if isinstance(image, str) and IMAGE_RE.match(image):
        return image
    raise Failure(4, "database image unknown (no supabase-db container, no db_image in ops.json)")


def pick_dump(name: str | None) -> tuple[str, dict]:
    base = path(PGDUMP_DIR)
    if name is not None:
        if not DIR_RE.match(name):
            raise Failure(2, "--dump must be a dump directory name (YYYYMMDDTHHMMSSZ)")
        candidates = [name]
    else:
        try:
            candidates = sorted((n for n in os.listdir(base) if DIR_RE.match(n)), reverse=True)
        except FileNotFoundError:
            candidates = []
    for candidate in candidates:
        meta = read_json(os.path.join(base, candidate, "meta.json"))
        if meta and isinstance(meta.get("tables"), list) and isinstance(meta.get("db"), dict):
            return os.path.join(base, candidate), meta
    raise Failure(11, f"no complete dump in {PGDUMP_DIR}")


def wait_ready(container: str) -> bool:
    deadline = time.monotonic() + READY_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        state = docker(["inspect", "--format", "{{.State.Running}}", container], timeout=30)
        if state.stdout.strip() != b"true":
            return False
        probe = docker(["exec", container, "psql", "-h", "127.0.0.1", "-U", DB_USER, "-d", "postgres", "-X", "-A",
                        "-t", "-c", "SELECT 1"], timeout=30)
        if probe.returncode == 0 and probe.stdout.strip() == b"1":
            return True
        time.sleep(3)
    return False


def restore(dump_dir: str, meta: dict) -> tuple[dict[str, bool], int, list[str]]:
    checks = {name: False for name in CHECKS}
    db_file = os.path.join(dump_dir, "db.dump")
    globals_file = os.path.join(dump_dir, "globals.sql")
    meta_db, meta_globals = meta.get("db") or {}, meta.get("globals") or {}
    checks["dump_integrity"] = (os.path.isfile(db_file) and os.path.isfile(globals_file)
                                and sha256_file(db_file) == meta_db.get("sha256")
                                and sha256_file(globals_file) == meta_globals.get("sha256"))
    if not checks["dump_integrity"]:
        return checks, 0, []
    image = db_image()
    container = f"legatto-restore-test-{secrets.token_hex(4)}"
    env = dict(os.environ, POSTGRES_PASSWORD=secrets.token_hex(24))
    started = docker(["run", "--detach", "--rm", "--network", "none", "--name", container,
                      "--label", "com.legatto.restore-test=1", "--memory", "2g", "--cpus", "1.5",
                      "--env", "POSTGRES_PASSWORD", image], timeout=120, env=env)
    if started.returncode != 0:
        return checks, 0, []
    restore_errors = 0
    mismatched: list[str] = []
    try:
        checks["container_started"] = wait_ready(container)
        if not checks["container_started"]:
            return checks, 0, []
        rc, _ = count_errors(["exec", "-i", container, "psql", "-h", "127.0.0.1", "-U", DB_USER, "-d", "template1",
                              "-X", "-q", "-v", "ON_ERROR_STOP=0", "-f", "-"], globals_file, 600, b"psql:")
        checks["globals_applied"] = rc == 0
        # A fresh database `postgres`: pg_cron can only live there, and objects
        # created by the image's init scripts must not collide with the dump.
        recreate = docker(["exec", container, "psql", "-h", "127.0.0.1", "-U", DB_USER, "-d", "template1", "-X",
                           "-q", "-v", "ON_ERROR_STOP=1", "-c", "DROP DATABASE postgres WITH (FORCE)",
                           "-c", "CREATE DATABASE postgres TEMPLATE template0"], timeout=120)
        if recreate.returncode != 0:
            return checks, 0, []
        rc, restore_errors = count_errors(["exec", "-i", container, "pg_restore", "-h", "127.0.0.1", "-U", DB_USER,
                                           "-d", "postgres", "--no-password"], db_file, RESTORE_TIMEOUT_SECONDS,
                                          b"pg_restore: error:")
        checks["pg_restore_clean"] = rc == 0 and restore_errors == 0
        actual = table_checksums(container)
        if actual is None:
            return checks, restore_errors, []
        expected = {t.get("name"): (t.get("rows"), t.get("sum")) for t in meta["tables"] if isinstance(t, dict)}
        missing = sorted(n for n in expected if n not in actual)
        wrong_rows = sorted(n for n in expected if n in actual and actual[n][0] != expected[n][0])
        wrong_sum = sorted(n for n in expected if n in actual and actual[n][1] != expected[n][1])
        checks["tables_present"] = bool(expected) and not missing
        checks["row_counts"] = checks["tables_present"] and not wrong_rows
        checks["checksums"] = checks["row_counts"] and not wrong_sum
        mismatched = sorted(set(missing) | set(wrong_rows) | set(wrong_sum))
    finally:
        docker(["rm", "--force", "--volumes", container], timeout=120)
    return checks, restore_errors, mismatched


def status_doc(prev: dict | None, *, now: datetime, state: str, duration: int, checks: dict, mode: str) -> dict:
    hetzner_ok = (prev or {}).get("hetzner_last_ok_at")
    if mode == "hetzner" and state == "ok":
        hetzner_ok = fmt_ts(now)
    return {"v": 1, "component": "restore-test", "ts": fmt_ts(utc_now()), "ok": state == "ok", "state": state,
            "last_run_at": fmt_ts(now), "duration_s": duration, "checks": checks, "mode": mode,
            "hetzner_last_ok_at": hetzner_ok}


def require_root() -> None:
    if not ROOT and os.geteuid() != 0:
        raise Failure(4, "must run as root")


def cmd_run(args: argparse.Namespace) -> int:
    actor = parse_actor(args.actor, required=False)
    require_root()
    guard = lock()
    try:
        now = utc_now()
        t0 = time.monotonic()
        dump_dir, meta = pick_dump(args.dump)
        checks, restore_errors, mismatched = restore(dump_dir, meta)
        duration = int(time.monotonic() - t0)
        state = "ok" if all(checks.values()) else "fail"
        report = {"v": 1, "mode": "local", "dump": os.path.basename(dump_dir),
                  "dump_created_at": meta.get("created_at"), "started_at": fmt_ts(now),
                  "finished_at": fmt_ts(utc_now()), "duration_s": duration, "state": state, "checks": checks,
                  "restore_errors": restore_errors,
                  "tables": {"total": len(meta["tables"]), "mismatched": mismatched}}
        prev = read_json(path(f"{STATUS_DIR}/restore-test.json"))
        write_status(status_doc(prev, now=now, state=state, duration=duration, checks=checks, mode="local"))
        seq = audit(actor, {"mode": "local", "state": state, "dump": report["dump"], "duration_s": duration,
                            "failed_checks": sorted(k for k, v in checks.items() if not v)})
    finally:
        guard.close()
    report["audit_seq"] = seq
    if args.report:
        with open(args.report, "w", encoding="utf-8") as fh:
            os.fchmod(fh.fileno(), 0o600)
            json.dump(report, fh, sort_keys=True, indent=1)
            fh.write("\n")
    if args.json:
        print(json.dumps(report, sort_keys=True, separators=(",", ":")))
    else:
        log(f"{state}: dump {report['dump']}, {len(meta['tables'])} tables, {duration} s")
    if state != "ok":
        return 10
    return 0 if seq is not None else 1


def _int(value: object, lo: int, hi: int) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and lo <= value <= hi


def validate_report(doc: dict | None) -> dict:
    """Strict shape of a Hetzner clone report; nothing free-form gets through."""
    def bad(why: str) -> Failure:
        return Failure(12, f"invalid report: {why}")

    if doc is None or doc.get("v") != 1 or doc.get("mode") != "hetzner":
        raise bad("v/mode")
    run, hz = doc.get("run"), doc.get("hetzner")
    if not isinstance(run, dict) or not isinstance(hz, dict):
        raise bad("run/hetzner missing")
    if run.get("state") not in ("ok", "fail") or not _int(run.get("duration_s"), 0, 10 ** 6):
        raise bad("run.state/duration_s")
    checks = run.get("checks")
    if not isinstance(checks, dict) or not checks or len(checks) > 20 \
            or not all(CHECK_RE.match(k) and isinstance(v, bool) for k, v in checks.items()):
        raise bad("run.checks")
    if run["state"] == "ok" and not all(checks.values()):
        raise bad("state ok with failed checks")
    if not isinstance(run.get("dump"), str) or not DIR_RE.match(run["dump"]):
        raise bad("run.dump")
    if not _int(hz.get("backup_image_id"), 1, 10 ** 12) or not _int(hz.get("backup_age_h"), 0, 10 ** 5):
        raise bad("hetzner.backup_image_id/backup_age_h")
    if not isinstance(hz.get("backup_created_at"), str) or not TS_RE.match(hz["backup_created_at"]):
        raise bad("hetzner.backup_created_at")
    if not _int(hz.get("clone_boot_s"), 0, 10 ** 5):
        raise bad("hetzner.clone_boot_s")
    return {"state": run["state"], "duration_s": run["duration_s"], "checks": dict(checks), "dump": run["dump"],
            "backup_image_id": hz["backup_image_id"], "backup_age_h": hz["backup_age_h"],
            "backup_created_at": hz["backup_created_at"], "clone_boot_s": hz["clone_boot_s"]}


def cmd_record(args: argparse.Namespace) -> int:
    actor = parse_actor(args.actor, required=True)
    if args.mode != "hetzner":
        raise Failure(2, "--mode must be hetzner")
    require_root()
    result = validate_report(read_json(args.report, limit=256 * 1024))
    guard = lock()
    try:
        now = utc_now()
        prev = read_json(path(f"{STATUS_DIR}/restore-test.json"))
        write_status(status_doc(prev, now=now, state=result["state"], duration=result["duration_s"],
                                checks=result["checks"], mode="hetzner"))
        seq = audit(actor, {"mode": "hetzner", "state": result["state"], "dump": result["dump"],
                            "duration_s": result["duration_s"], "backup_image_id": result["backup_image_id"],
                            "backup_created_at": result["backup_created_at"], "backup_age_h": result["backup_age_h"],
                            "clone_boot_s": result["clone_boot_s"],
                            "failed_checks": sorted(k for k, v in result["checks"].items() if not v)})
    finally:
        guard.close()
    if args.json:
        print(json.dumps(dict(result, audit_seq=seq), sort_keys=True, separators=(",", ":")))
    if seq is None:
        return 1
    return 0 if result["state"] == "ok" else 10


def cmd_status(args: argparse.Namespace) -> int:
    doc = read_json(path(f"{STATUS_DIR}/restore-test.json"))
    if doc is None:
        doc = {"v": 1, "component": "restore-test", "state": "none"}
    if args.json:
        print(json.dumps(doc, sort_keys=True, separators=(",", ":")))
    else:
        print(f"state={doc.get('state')} last_run_at={doc.get('last_run_at')} mode={doc.get('mode')} "
              f"hetzner_last_ok_at={doc.get('hetzner_last_ok_at')}")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="legatto-restore-test", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    p_run = sub.add_parser("run", help="restore the newest dump into a throw-away container and compare")
    p_run.add_argument("--dump", help="dump directory name (default: newest)")
    p_run.add_argument("--report", help="write the JSON report (no table content) to FILE")
    p_run.add_argument("--json", action="store_true")
    p_run.add_argument("--actor")
    p_record = sub.add_parser("record", help="store the result of a Hetzner clone restore test")
    p_record.add_argument("--report", required=True)
    p_record.add_argument("--mode", required=True)
    p_record.add_argument("--json", action="store_true")
    p_record.add_argument("--actor")
    p_status = sub.add_parser("status")
    p_status.add_argument("--json", action="store_true")
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return 2 if exc.code else 0
    try:
        return {"run": cmd_run, "record": cmd_record, "status": cmd_status}[args.command](args)
    except Failure as exc:
        log(str(exc))
        return exc.code
    except subprocess.TimeoutExpired:
        log("timed out")
        return 1
    except Exception as exc:  # noqa: BLE001
        log(f"unexpected error: {type(exc).__name__}")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
