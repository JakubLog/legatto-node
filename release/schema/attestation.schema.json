{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.legatto.pl/schema/attestation.schema.json",
  "title": "Legatto canary attestation (legatto-canary/1)",
  "description": "Written and signed by the permanent canary server after it installed the release and ran `scripts/verify.sh --release`. Published as releases/<version>/attest/canary.json with canary.json.canary.sig (`ssh-keygen -Y sign -n legatto-canary`, software ed25519 key of the canary server). It installs nothing by itself; it is an input to promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "version",
    "sequence",
    "manifest_sha256",
    "result",
    "verify_report_sha256",
    "installed_at",
    "finished_at",
    "canary"
  ],
  "properties": {
    "schema": { "const": "legatto-canary/1" },
    "product": { "const": "legatto" },
    "version": { "$ref": "#/$defs/semver" },
    "sequence": { "type": "integer", "minimum": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "result": {
      "description": "Only PASS can be referenced by a promotion. FAIL is published for transparency.",
      "enum": ["PASS", "FAIL"]
    },
    "verify_report_sha256": {
      "description": "sha256 of the verify.sh JSON report (published next to the attestation as verify-report.json).",
      "$ref": "#/$defs/sha256"
    },
    "installed_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "canary": {
      "description": "Slug of the canary office.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    "failed_checks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,80}$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "FAIL" } } },
      "then": { "required": ["failed_checks"], "properties": { "failed_checks": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
